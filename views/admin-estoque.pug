extends layout

block content
  main.admin-page
    a.admin-back-link(href='/admin')
      i.bi.bi-arrow-left
      | Painel administrativo
    p.admin-eyebrow ESTOQUE
    h1.admin-title Controle de estoque
    p.admin-subtitle Ajuste as unidades físicas e acompanhe o que está disponível para aluguel.
    section.admin-product-filters(data-admin-product-filters)
      label.admin-product-search
        span Pesquisar produtos
        input(type='search' placeholder='Nome, categoria ou subcategoria' data-admin-product-search)
      .admin-category-card
        .admin-category-row(aria-label='Categorias de produtos')
          button.admin-category-button.is-active(type='button' data-filter-category='') Todas
          each category in (categories || [])
            button.admin-category-button(type='button' data-filter-category=category)= category
        .admin-subcategory-row(data-subcategory-row hidden)
    if stockError
      p.admin-form-error= stockError
    .stock-grid
      each product in products
        article.stock-card(data-stock-card=product._id data-admin-product data-category=product.category data-subcategories=JSON.stringify(product.subcategories || []))
          .stock-card-photo
            if product.imageUrl
              img(src=product.imageUrl alt='Foto de ' + product.name)
            else
              i.bi.bi-image(aria-hidden='true')
          .stock-card-header
            div
              h2= product.name
              p= product.category
            if product.availableUnits > 0
              span.admin-stock-available Disponível
            else
              span.admin-stock-unavailable Indisponível
          if product.category === 'kit-montagem' || product.category === 'festa-infantil'
            .stock-card-composite-availability
              strong= product.category === 'kit-montagem' ? 'Kits disponíveis: ' : 'Festas disponíveis: '
              span= product.availableUnits
            p.admin-form-hint Quantidade calculada com base no estoque disponível dos componentes.
          else
            .stock-card-details
              span
                | Total:
                strong(data-stock-total)= product.stockTotal || 0
              span
                | Alugado:
                strong(data-stock-rented)= product.rentedQuantity || 0
              span
                | Solicitação:
                strong= product.requestedQuantity || 0
              span
                | Livre:
                strong(data-stock-available)= product.availableUnits
            form.stock-adjust-form(method='post' action='/admin/estoque/' + product._id data-stock-form)
              input(type='hidden' name='amount' data-stock-amount)
              button.stock-adjust-button(type='submit' data-stock-amount-value='-1' aria-label='Remover uma unidade' title='Remover uma unidade')
                i.bi.bi-dash-lg(aria-hidden='true')
              output.stock-quantity(data-stock-total)= product.stockTotal || 0
              button.stock-adjust-button(type='submit' data-stock-amount-value='1' aria-label='Adicionar uma unidade' title='Adicionar uma unidade')
                i.bi.bi-plus-lg(aria-hidden='true')
      else
        .admin-empty
          i.bi.bi-box-seam
          p Nenhum produto cadastrado.
      if products.length
        .admin-empty.admin-filter-empty(data-filter-empty hidden)
          p Nenhum produto corresponde aos filtros selecionados.
  script.
    (function() {
      var filters = document.querySelector('[data-admin-product-filters]');
      if (filters) {
        var items = Array.prototype.slice.call(document.querySelectorAll('[data-admin-product]'));
        var categoryButtons = filters.querySelectorAll('[data-filter-category]');
        var subcategoryRow = filters.querySelector('[data-subcategory-row]');
        var search = filters.querySelector('[data-admin-product-search]');
        var empty = document.querySelector('[data-filter-empty]');
        var categoryLabels = { brinquedos: 'Brinquedos', decoracoes: 'Decorações', 'kit-montagem': 'Kits de montagem', 'festa-infantil': 'Festas infantis' };
        var selectedCategory = '';
        var selectedSubcategory = '';
        function renderSubcategories() {
          subcategoryRow.innerHTML = '';
          if (!selectedCategory) { subcategoryRow.hidden = true; selectedSubcategory = ''; return; }
          subcategoryRow.hidden = false;
          var names = [];
          items.forEach(function(item) {
            if (item.dataset.category !== selectedCategory) return;
            try { JSON.parse(item.dataset.subcategories || '[]').forEach(function(name) { if (names.indexOf(name) === -1) names.push(name); }); } catch (error) {}
          });
          names.sort(function(a, b) { return a.localeCompare(b, 'pt-BR'); });
          [['', 'Geral']].concat(names.map(function(name) { return [name, name]; })).forEach(function(entry) {
            var button = document.createElement('button');
            button.type = 'button'; button.className = 'admin-subcategory-button' + (entry[0] === selectedSubcategory ? ' is-active' : '');
            button.textContent = entry[1];
            button.addEventListener('click', function() { selectedSubcategory = entry[0]; renderSubcategories(); applyFilters(); });
            subcategoryRow.appendChild(button);
          });
        }
        function applyFilters() {
          var term = search.value.trim().toLocaleLowerCase();
          var visible = 0;
          items.forEach(function(item) {
            var subcategories = [];
            try { subcategories = JSON.parse(item.dataset.subcategories || '[]'); } catch (error) {}
            var matchesCategory = !selectedCategory || item.dataset.category === selectedCategory;
            var matchesSubcategory = !selectedSubcategory || subcategories.indexOf(selectedSubcategory) !== -1;
            item.hidden = !(matchesCategory && matchesSubcategory && (!term || item.textContent.toLocaleLowerCase().indexOf(term) !== -1));
            if (!item.hidden) visible += 1;
          });
          if (empty) empty.hidden = visible > 0;
        }
        categoryButtons.forEach(function(button) {
          var labels = categoryLabels;
          if (button.dataset.filterCategory) button.textContent = labels[button.dataset.filterCategory] || button.dataset.filterCategory;
          button.addEventListener('click', function() {
            selectedCategory = button.dataset.filterCategory;
            selectedSubcategory = '';
            categoryButtons.forEach(function(choice) { choice.classList.toggle('is-active', choice === button); });
            renderSubcategories(); applyFilters();
          });
        });
        search.addEventListener('input', applyFilters);
        applyFilters();
      }
      document.querySelectorAll('[data-stock-form]').forEach(function(form) {
        form.querySelectorAll('[data-stock-amount-value]').forEach(function(button) {
          button.addEventListener('click', function() { form.querySelector('[data-stock-amount]').value = button.dataset.stockAmountValue; });
        });
        form.addEventListener('submit', function(event) {
          event.preventDefault();
          var card = form.closest('[data-stock-card]');
          fetch(form.action, {
            method: 'POST',
            body: new URLSearchParams({ amount: form.querySelector('[data-stock-amount]').value }),
            headers: { Accept: 'application/json', 'Content-Type': 'application/x-www-form-urlencoded' }
          })
            .then(function(response) {
              return response.json().then(function(result) { return { ok: response.ok, result: result }; });
            })
            .then(function(data) {
              if (!data.ok) return window.alert(data.result.message || 'Não foi possível atualizar o estoque.');
              card.querySelectorAll('[data-stock-total]').forEach(function(output) { output.textContent = data.result.stockTotal; });
              card.querySelector('[data-stock-rented]').textContent = data.result.rentedQuantity;
              card.querySelector('[data-stock-available]').textContent = data.result.availableUnits;
            })
            .catch(function() { window.alert('Não foi possível atualizar o estoque.'); });
        });
      });
    })();
