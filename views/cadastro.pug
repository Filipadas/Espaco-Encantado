doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title Criar conta | Espaço Encantado
    link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css')
    link(rel='stylesheet' href='/stylesheets/style.css?v=20261014-fit-mobile')
  body.auth-page
    main.register-screen
      section.register-header
        .register-topbar
          a.auth-back-link(href='/login')
            i.bi.bi-arrow-left(aria-hidden='true')
            | Voltar para entrar
          a.auth-home-button(href='/' aria-label='Ir para a página inicial' title='Página inicial')
            i.bi.bi-house-fill(aria-hidden='true')
        .auth-brand
          img.auth-logo(src='/images/logo_ee.png' alt='Espaço Encantado')
      button.theme-toggle.auth-theme-toggle(type='button' data-auth-theme-toggle aria-label='Alternar modo escuro' title='Alternar modo escuro')
        i.bi.bi-moon-stars-fill(aria-hidden='true')
      section.register-panel(aria-labelledby='register-title')
        form.auth-form.register-form(method='post' action='/register')
          h1#register-title.auth-title Criar cadastro
          p.auth-subtitle Seus dados ajudam a personalizar sua experiência.
          if registerError
            p.auth-form-error= registerError
          .register-fields
            .auth-field
              label(for='register-name') Nome completo
              input#register-name(type='text' name='name' autocomplete='name' required value=(formData && formData.name || ''))
            .auth-field
              label(for='register-email') E-mail
              input#register-email(type='email' name='email' autocomplete='email' required value=(formData && formData.email || ''))
            .auth-field
              label(for='register-phone') Telefone
              input#register-phone(type='tel' name='phone' autocomplete='tel' value=(formData && formData.phone || ''))
            .auth-field
              label(for='register-birth') Data de nascimento
              input#register-birth(type='date' name='birthDate' value=(formData && formData.birthDate || ''))
            .auth-field.auth-field-wide
              label(for='register-address') Endereço
              input#register-address(type='text' name='address' autocomplete='street-address' value=(formData && formData.address || ''))
            .register-location-fields
              .auth-field
                label(for='register-city') Cidade
                input#register-city(type='text' name='city' autocomplete='address-level2' required disabled value=(formData && formData.city || ''))
              .auth-field
                label(for='register-state') Estado
                select#register-state(name='state' autocomplete='address-level1' required)
                  option(value='') UF
                  each stateCode in ['AC','AL','AP','AM','BA','CE','DF','ES','GO','MA','MT','MS','MG','PA','PB','PR','PE','PI','RJ','RN','RS','RO','RR','SC','SP','SE','TO']
                    option(value=stateCode selected=(formData && formData.state === stateCode))= stateCode
              .auth-field
                label(for='register-cep') CEP
                input#register-cep(type='text' name='cep' autocomplete='postal-code' inputmode='numeric' maxlength='9' placeholder='00000-000' value=(formData && formData.cep || ''))
            .auth-field
              label(for='register-password') Senha
              input#register-password(type='password' name='password' autocomplete='new-password' required)
            .auth-field
              label(for='register-confirm-password') Confirmar senha
              input#register-confirm-password(type='password' name='confirmPassword' autocomplete='new-password' required)
          button.auth-submit(type='submit') Criar minha conta
      script.
        (function() {
          var stateSelect = document.getElementById('register-state');
          var cityInput = document.getElementById('register-city');
          function syncCityField() { cityInput.disabled = !stateSelect.value; }
          stateSelect.addEventListener('change', syncCityField);
          syncCityField();
        })();
        (function() {
          var toggle = document.querySelector('[data-auth-theme-toggle]');
          var dark = window.localStorage.getItem('espaco-encantado-theme') === 'dark';
          document.body.classList.toggle('dark-mode', dark);
          if (toggle) toggle.addEventListener('click', function() {
            dark = !dark;
            document.body.classList.toggle('dark-mode', dark);
            window.localStorage.setItem('espaco-encantado-theme', dark ? 'dark' : 'light');
          });
        })();

