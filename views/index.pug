extends layout

block content
  section.landing-area
    .landing-section
      .landing-card
        h2.landing-title Seu sonho em forma de festa
        h3.landing-subtitle Bem-vindo(a) ao Espaço Encantado!
        p.landing-text
          | Aqui, cada detalhe é pensado para
          br
          | transformar o seu evento em um momento
          br
          | único e cheio de magia.

  section.cards-area
    .cards-section
      .cards-container
        .card-wrapper
          h3.card-title NOSSO OBJETIVO
          .card-item
            p.card-text A Espaço Encantado tem como objetivo tornar cada festa incrível, transformando sonhos em realidade e criando momentos mágicos!

        .card-wrapper
          h3.card-title SERVIÇOS
          .card-item
            p.card-text Nossa loja oferece tudo para a sua comemoração: decorações, brinquedos e artigos de festa para tornar cada momento inesquecível!

  section.function-area
    .balloons-intro
        img(src='./images/baloes_intro.png', alt='Balões introdutórios')
        .balloons-overlay
          .balloon-card
            .balloon-icon
              i.bi.bi-clock
            h3.balloon-title HORÁRIOS
            p.balloon-text
              | Horário de funcionamento:
              br
              | Segunda: 13h30 – 18h00
              br
              | Terça a Sexta: 08h00 – 18h00
              br
              | Sábado: 08h00 – 12h00
              br
              | Domingo: Fechado

          .balloon-card
            .balloon-icon
              i.bi.bi-geo-alt-fill
            h3.balloon-title LOCALIZAÇÃO
            p.balloon-text
              | Estamos localizados na R. Ricardo Inácio,
              br
              | em Praia Grande – SC.
              br
              | Venha nos visitar e encantar-se com nossas decorações
              br
              | e serviços — esperamos por você!

  section.carousel-area
    h3.carousel-title Conheça nossas decorações, clique para saber mais
    #carouselExampleCaptions.carousel.slide(style='margin-top: 24px;')
      .carousel-indicators
        button.active(type='button' data-bs-target='#carouselExampleCaptions' data-bs-slide-to='0' aria-current='true' aria-label='Slide 1')
        button(type='button' data-bs-target='#carouselExampleCaptions' data-bs-slide-to='1' aria-label='Slide 2')
        button(type='button' data-bs-target='#carouselExampleCaptions' data-bs-slide-to='2' aria-label='Slide 3')
      .carousel-inner
        .carousel-item.active
          img(src='/images/fotoee1.jpeg' class='d-block w-100' alt='Decoração Espaço Encantado 1')
        .carousel-item
          img(src='/images/fotoee2.jpeg' class='d-block w-100' alt='Decoração Espaço Encantado 2')
        .carousel-item
          img(src='/images/fotoee3.jpeg' class='d-block w-100' alt='Decoração Espaço Encantado 3')
      button.carousel-control-prev(type='button' data-bs-target='#carouselExampleCaptions' data-bs-slide='prev')
        span.carousel-control-prev-icon(aria-hidden='true')
        span.visually-hidden Previous
      button.carousel-control-next(type='button' data-bs-target='#carouselExampleCaptions' data-bs-slide='next')
        span.carousel-control-next-icon(aria-hidden='true')
        span.visually-hidden Next

  section.meeting-area
    .agenda-section
      .agenda-visual
        img(src='./images/baloes_agenda.png' alt='Balões com agenda')
        .agenda-overlay
          .agenda-left-block
            h3.agenda-card-title Precisa marcar uma reunião para alinhar seus objetivos?
            .agenda-card.agenda-card-left
              p.agenda-card-text
                | A reunião é importante para entendermos suas ideias, alinhar os detalhes da festa e criar uma decoração personalizada do jeito que você imaginou.
          .agenda-card.agenda-card-right
            h3.agenda-card-title Faça seu agendamento:
            button.btn.btn-agenda(type='button' data-open-scheduler) Agendar

  .scheduler-modal(aria-hidden='true' data-scheduler-modal)
    .scheduler-dialog(role='dialog' aria-modal='true' aria-label='Agendamento')
      button.scheduler-close(type='button' aria-label='Fechar calendário' data-close-scheduler)
        i.bi.bi-x-lg
      p.scheduler-eyebrow AGENDAMENTO
      .scheduler-week-header
        button.scheduler-week-button(type='button' aria-label='Semana anterior' data-previous-week)
          i.bi.bi-chevron-left
        strong.scheduler-week-label(data-week-label)
        button.scheduler-week-button(type='button' aria-label='Próxima semana' data-next-week)
          i.bi.bi-chevron-right
      .scheduler-days(data-scheduler-days)
      .scheduler-times(data-scheduler-times)
      form.scheduler-form(method='post' action='/reunioes' data-scheduler-form)
        input#scheduler-date(type='hidden' name='date' required)
        input#scheduler-time(type='hidden' name='time' required)
        button.btn.scheduler-submit(type='submit') Solicitar reunião
      p.scheduler-feedback(role='status' data-scheduler-feedback)

  section.catalog-start-area
    .catalog-section
      h3.catalog-title Acesse nossos catálogos
      form.catalog-search(role='search')
        input.form-control(type='search' placeholder='Pesquisar' aria-label='Pesquisar catálogo')

      .catalog-carousel(data-catalog-carousel)
        .catalog-grid(data-catalog-track)
          a.catalog-card.is-active(href='/catalogo?estado=brinquedos' data-catalog-slide='0' data-catalog-state='brinquedos')
            h4.catalog-card-title Brinquedos
          a.catalog-card(href='/catalogo?estado=decoracoes' data-catalog-slide='1' data-catalog-state='decoracoes')
            h4.catalog-card-title Decorações
          a.catalog-card(href='/catalogo?estado=kit-montagem' data-catalog-slide='2' data-catalog-state='kit-montagem')
            h4.catalog-card-title Kit de montagem
          a.catalog-card(href='/catalogo?estado=festa-infantil' data-catalog-slide='3' data-catalog-state='festa-infantil')
            h4.catalog-card-title Festa infantil


  section.history-area
    .history-story-band
      h2.history-top-title Conheça um pouco da nossa história

      .history-story-card
        p O ponto de partida da loja espaço encantado ocorreu em 2005, um período marcado por desafios e recursos limitados. A proprietária Elisabete, com poucos meios para investir, começou utilizando materiais simples como folhas de E.V.A., TNT e isopor em suas primeiras decorações.
        p Com o tempo, iniciou sua caminhada como empreendedora, investindo em artigos para festas e montando sua primeira loja na sala de casa. A partir daí, o negócio evoluiu gradualmente até se consolidar e se tornar a grande realizadora de sonhos que é hoje.


  section.catalog-area.products-section
    h2.products-title Conheça um pouco dos nossos produtos:
    .products-grid
      each product in homeProducts
        article.catalog-product-card(data-product-id=product._id data-favorite-product=product._id)
          .catalog-product-photo
            if product.imageUrl
              img(src=product.imageUrl alt='Foto de ' + product.name)
            else
              span Foto
          .catalog-product-summary
            h2.catalog-product-name= product.name
            p.catalog-product-price R$ #{Number(product.price).toFixed(2).replace('.', ',')}
            p.catalog-product-description= product.description || 'Produto disponível para sua festa.'
          button.catalog-card-toggle(type='button' aria-label='Ver detalhes de ' + product.name aria-expanded='false')
            i.bi.bi-chevron-up(aria-hidden='true')
          .catalog-product-details
            h2.catalog-product-name= product.name
            p.catalog-product-price R$ #{Number(product.price).toFixed(2).replace('.', ',')}
            .catalog-product-actions
              button.catalog-icon-button(type='button' data-favorite=product._id aria-label='Favoritar ' + product.name aria-pressed='false' title='Favoritar')
                i.bi.bi-heart(aria-hidden='true')
              if product.availableUnits > 0
                form(method='post' action='/sacola/add' data-cart-form)
                  input(type='hidden' name='productId' value=product._id)
                  button.catalog-icon-button(type='submit' aria-label='Adicionar ' + product.name + ' à sacola' title='Adicionar à sacola')
                    i.bi.bi-bag-plus(aria-hidden='true')
              else
                span.catalog-product-availability.is-unavailable(title='Este item está sendo utilizado')
                  i.bi.bi-slash-circle(aria-hidden='true')
      else
        p.catalog-empty Nenhum produto cadastrado ainda.
    a.products-more-button(href='/catalogo?estado=brinquedos') Ver mais

  script.
    (function() {
      document.querySelectorAll('[data-favorite-product]').forEach(function(card) {
        card.addEventListener('click', function(event) {
          if (event.target.closest('button, form, a')) return;
          window.location.href = '/produto/' + card.dataset.productId;
        });
      });
      document.querySelectorAll('.catalog-card-toggle').forEach(function(button) {
        button.addEventListener('click', function() {
          var card = button.closest('.catalog-product-card');
          var expanded = card.classList.toggle('is-expanded');
          button.setAttribute('aria-expanded', String(expanded));
        });
      });
      document.querySelectorAll('[data-cart-form]').forEach(function(form) {
        form.addEventListener('submit', function(event) {
          event.preventDefault();
          fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } })
            .then(function(response) {
              if (response.url.indexOf('/login') !== -1) return window.location.href = response.url;
              return response.json();
            })
            .then(function(result) { if (result && result.message) window.alert(result.message); })
            .catch(function() { window.alert('Não foi possível adicionar o produto à sacola.'); });
        });
      });
      var favorites = JSON.parse(localStorage.getItem('espaco-encantado-favorites') || '[]');
      document.querySelectorAll('[data-favorite]').forEach(function(button) {
        var id = button.dataset.favorite;
        var update = function() {
          var active = favorites.indexOf(id) !== -1;
          button.setAttribute('aria-pressed', String(active));
          button.classList.toggle('is-favorite', active);
        };
        update();
        button.addEventListener('click', function() {
          var position = favorites.indexOf(id);
          if (position === -1) favorites.push(id);
          else favorites.splice(position, 1);
          localStorage.setItem('espaco-encantado-favorites', JSON.stringify(favorites));
          update();
        });
      });
    })();

