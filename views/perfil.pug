extends layout

block content
  main.admin-page
    p.admin-eyebrow MINHA CONTA
    h1.admin-title= currentUser.name
    p.admin-subtitle= currentUser.email
    .profile-actions
      a.admin-primary-button(href=isAdmin ? '/admin' : '/sacola')
        i.bi(class=isAdmin ? 'bi-award-fill' : 'bi-bag-fill')
        = isAdmin ? ' Abrir área administrativa' : ' Abrir minha sacola'
      form(method='post' action='/logout')
        button.admin-danger-button(type='submit') Sair da conta