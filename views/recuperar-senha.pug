doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title Recuperar senha | Espaço Encantado
    link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css')
    link(rel='stylesheet' href='/stylesheets/style.css?v=20261017-produto-mobile')
  body.delete-account-page
    main.confirmation-page
      .confirmation-card
        img.auth-logo(src='/images/logo_ee.png' alt='Espaço Encantado')
        h1.admin-title Recuperar senha
        p.admin-subtitle Informe o e-mail ou telefone da sua conta. Vamos abrir uma conversa com a loja pelo WhatsApp para confirmar sua identidade e ajudar a recuperar o acesso.
        if formError
          p.admin-form-error= formError
        form.admin-form(method='post' action='/recuperar-senha')
          input(type='hidden' name='returnTo' value=returnTo || '/')
          label(for='recovery-contact') E-mail ou telefone
          input#recovery-contact(type='text' name='contact' required autocomplete='email' placeholder='seu@email.com ou (00) 00000-0000')
          .profile-actions
            a.admin-small-button.confirm-cancel-button(href='/entrar' + (returnTo && returnTo !== '/' ? '?returnTo=' + encodeURIComponent(returnTo) : '')) Voltar ao login
            button.admin-primary-button(type='submit') Continuar pelo WhatsApp
