doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title Recuperar senha | Espaço Encantado
    link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css')
    link(rel='stylesheet' href='/stylesheets/style.css?v=20261017-produto-mobile')
  body.delete-account-page
    main.confirmation-page
      .confirmation-card
        img.auth-logo(src='/images/logo_ee.png' alt='Espaço Encantado')
        h1.admin-title Recuperar senha
        p.admin-subtitle Informe seu e-mail cadastrado. Enviaremos um código para validar sua identidade.
        if formError
          p.admin-form-error= formError
        form.admin-form(method='post' action='/recuperar-senha/enviar')
          input(type='hidden' name='returnTo' value=returnTo || '/')
          label(for='recovery-email') E-mail
          input#recovery-email(type='email' name='email' required autocomplete='email' placeholder='seu@email.com')
          .profile-actions
            a.admin-small-button.confirm-cancel-button(href='/entrar' + (returnTo && returnTo !== '/' ? '?returnTo=' + encodeURIComponent(returnTo) : '')) Voltar ao login
            button.admin-primary-button(type='submit') Enviar código
