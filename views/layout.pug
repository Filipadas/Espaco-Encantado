        script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js")
        script.
                        (function() {
                            var modal = document.querySelector('[data-scheduler-modal]');
                            var openButton = document.querySelector('[data-open-scheduler]');
                            if (!modal || !openButton) return;

                            var closeButton = modal.querySelector('[data-close-scheduler]');
                            var form = modal.querySelector('[data-scheduler-form]');
                            var dateInput = modal.querySelector('#scheduler-date');
                                                        var timeInput = modal.querySelector('#scheduler-time');
                                                        var weekLabel = modal.querySelector('[data-week-label]');
                                                        var daysContainer = modal.querySelector('[data-scheduler-days]');
                                                        var timesContainer = modal.querySelector('[data-scheduler-times]');
                                                        var currentWeek = new Date();
                            var feedback = modal.querySelector('[data-scheduler-feedback]');

                                                        var dayNames = ['DOM', 'SEG', 'TER', 'QUA', 'QUI', 'SEX', 'SAB'];
                                                        var timeGroups = [
                                                            { name: 'Manhã', times: ['08:00', '09:00', '10:00', '11:00'] },
                                                              { name: 'Tarde', times: ['13:00', '14:00', '15:00', '16:00', '17:00'] },
                                                            { name: 'Noite', times: ['18:00', '19:00', '20:00'] }
                                                        ];

                                                        function formatDate(date) {
                                                            var year = date.getFullYear();
                                                            var month = String(date.getMonth() + 1).padStart(2, '0');
                                                            var day = String(date.getDate()).padStart(2, '0');
                                                            return year + '-' + month + '-' + day;
                                                        }

                                                        function getStartOfWeek(date) {
                                                            var start = new Date(date);
                                                            start.setHours(0, 0, 0, 0);
                                                            start.setDate(start.getDate() - start.getDay());
                                                            return start;
                                                        }

                                                        function renderDays() {
                                                            var start = getStartOfWeek(currentWeek);
                                                            var today = formatDate(new Date());
                                                            daysContainer.innerHTML = '';
                                                            weekLabel.textContent = start.toLocaleDateString('pt-BR', { month: 'long', year: 'numeric' });

                                                            for (var index = 0; index < 7; index += 1) {
                                                                var date = new Date(start);
                                                                date.setDate(start.getDate() + index);
                                                                var dateValue = formatDate(date);
                                                                var dayButton = document.createElement('button');
                                                                dayButton.type = 'button';
                                                                dayButton.className = 'scheduler-day';
                                                                dayButton.dataset.date = dateValue;
                                                                dayButton.innerHTML = '<span>' + dayNames[date.getDay()] + '</span><strong>' + date.getDate() + '</strong>';
                                                                if (dateValue === today) dayButton.classList.add('is-today');
                                                                if (dateValue < today) {
                                                                    dayButton.disabled = true;
                                                                    dayButton.classList.add('is-disabled');
                                                                }
                                                                if (dateValue === dateInput.value) dayButton.classList.add('is-selected');
                                                                dayButton.addEventListener('click', function() {
                                                                    if (this.disabled) return;
                                                                    dateInput.value = this.dataset.date;
                                                                    modal.querySelectorAll('.scheduler-day').forEach(function(button) {
                                                                        button.classList.remove('is-selected');
                                                                    });
                                                                    this.classList.add('is-selected');
                                                                    timeInput.value = '';
                                                                    renderTimes();
                                                                });
                                                                daysContainer.appendChild(dayButton);
                                                            }
                                                        }

                                                        function renderTimes() {
                                                            timesContainer.innerHTML = '';
                                                            timeGroups.forEach(function(group) {
                                                                var groupElement = document.createElement('section');
                                                                groupElement.className = 'scheduler-time-group';
                                                                groupElement.innerHTML = '<h3>' + group.name + '</h3><div class="scheduler-time-grid"></div>';
                                                                var grid = groupElement.querySelector('.scheduler-time-grid');
                                                                group.times.forEach(function(time) {
                                                                    var timeButton = document.createElement('button');
                                                                    timeButton.type = 'button';
                                                                    timeButton.className = 'scheduler-time';
                                                                    timeButton.textContent = time;
                                                                    timeButton.dataset.time = time;
                                                                    var now = new Date();
                                                                    var selectedDate = dateInput.value;
                                                                    var today = formatDate(now);
                                                                    if (selectedDate < today || (selectedDate === today && time <= now.toTimeString().slice(0, 5))) {
                                                                        timeButton.disabled = true;
                                                                        timeButton.classList.add('is-disabled');
                                                                    }
                                                                    timeButton.addEventListener('click', function() {
                                                                        if (this.disabled) return;
                                                                        timeInput.value = this.dataset.time;
                                                                        modal.querySelectorAll('.scheduler-time').forEach(function(button) {
                                                                            button.classList.remove('is-selected');
                                                                        });
                                                                        this.classList.add('is-selected');
                                                                    });
                                                                    grid.appendChild(timeButton);
                                                                });
                                                                timesContainer.appendChild(groupElement);
                                                            });
                                                        }

                            function closeModal() {
                                modal.classList.remove('is-visible');
                                modal.setAttribute('aria-hidden', 'true');
                                document.body.classList.remove('scheduler-open');
                                openButton.focus();
                            }

                            openButton.addEventListener('click', function() {
                                                                currentWeek = new Date();
                                                                dateInput.value = formatDate(new Date());
                                                                timeInput.value = '';
                                feedback.textContent = '';
                                                                renderDays();
                                                                renderTimes();
                                modal.classList.add('is-visible');
                                modal.setAttribute('aria-hidden', 'false');
                                document.body.classList.add('scheduler-open');
                                                                modal.querySelector('.scheduler-day.is-selected').focus();
                            });

                                                        modal.querySelector('[data-previous-week]').addEventListener('click', function() {
                                                            currentWeek.setDate(currentWeek.getDate() - 7);
                                                            renderDays();
                                                        });
                                                        modal.querySelector('[data-next-week]').addEventListener('click', function() {
                                                            currentWeek.setDate(currentWeek.getDate() + 7);
                                                            renderDays();
                                                        });

                            closeButton.addEventListener('click', closeModal);
                            modal.addEventListener('click', function(event) {
                                if (event.target === modal) closeModal();
                            });
                            document.addEventListener('keydown', function(event) {
                                if (event.key === 'Escape' && modal.classList.contains('is-visible')) closeModal();
                            });
                            form.addEventListener('submit', function(event) {
                                if (!dateInput.value || !timeInput.value) {
                                    event.preventDefault();
                                    feedback.textContent = 'Escolha uma data e um horário.';
                                }
                            });
                        })();
                        (function() {
                            var navbar = document.querySelector('.navbar-encantado');
                            var loginImage = document.querySelector('.login-image');
                            if (!navbar || !loginImage || !('IntersectionObserver' in window)) return;

                            var observer = new IntersectionObserver(function(entries) {
                                navbar.classList.toggle('navbar-login-hidden', entries[0].isIntersecting);
                            }, { threshold: 0.1 });
                            observer.observe(loginImage);
                        })();
                        (function() {
                            var carousel = document.querySelector('[data-catalog-carousel]');
                            if (!carousel) return;

                            var slides = Array.prototype.slice.call(carousel.querySelectorAll('[data-catalog-slide]'));
                            var currentIndex = 0;

                            function updateCarousel(nextIndex) {
                                currentIndex = Math.max(0, Math.min(nextIndex, slides.length - 1));
                                slides.forEach(function(slide, index) {
                                    var distance = index - currentIndex;
                                    slide.classList.remove('is-active', 'is-before', 'is-after', 'is-far-before', 'is-far-after', 'is-farthest-before', 'is-farthest-after');
                                    if (index === currentIndex) slide.classList.add('is-active');
                                    if (distance === -1) slide.classList.add('is-before');
                                    if (distance === 1) slide.classList.add('is-after');
                                    if (distance === -2) slide.classList.add('is-far-before');
                                    if (distance === 2) slide.classList.add('is-far-after');
                                    if (distance === -3) slide.classList.add('is-farthest-before');
                                    if (distance === 3) slide.classList.add('is-farthest-after');
                                });
                            }

                            slides.forEach(function(slide, index) {
                                slide.addEventListener('click', function(event) {
                                    if (this.classList.contains('is-active')) return;

                                    event.preventDefault();
                                    updateCarousel(index);
                                });
                            });
                            updateCarousel(0);
                        })();
                        (function() {
                            var toggle = document.querySelector('[data-theme-toggle]');
                            if (!toggle) return;

                            var icon = toggle.querySelector('i');

                            function applyTheme(isDark) {
                                document.body.classList.toggle('dark-mode', isDark);
                                toggle.setAttribute('aria-pressed', String(isDark));
                                toggle.setAttribute('aria-label', isDark ? 'Ativar modo claro' : 'Ativar modo escuro');
                                toggle.setAttribute('title', isDark ? 'Modo claro' : 'Modo escuro');
                                icon.className = isDark ? 'bi bi-sun-fill' : 'bi bi-moon-stars-fill';
                            }

                            var savedTheme = window.localStorage.getItem('espaco-encantado-theme');
                            applyTheme(savedTheme === 'dark');
                            toggle.addEventListener('click', function() {
                                var isDark = !document.body.classList.contains('dark-mode');
                                applyTheme(isDark);
                                window.localStorage.setItem('espaco-encantado-theme', isDark ? 'dark' : 'light');
                            });
                        })();
                        (function() {
                            var widgets = document.querySelectorAll('[data-product-search-widget]');
                            widgets.forEach(function(widget) {
                                var input = widget.querySelector('[data-product-search-input]');
                                var dropdown = widget.querySelector('[data-product-search-suggestions]');
                                if (!input || !dropdown) return;
                                var timer;
                                function closeDropdown() { dropdown.hidden = true; dropdown.innerHTML = ''; }
                                function render(products) {
                                    dropdown.innerHTML = '';
                                    if (!products.length) { closeDropdown(); return; }
                                    products.slice(0, 3).forEach(function(product) {
                                        var link = document.createElement('a');
                                        link.className = 'product-search-suggestion';
                                        link.href = '/produto/' + encodeURIComponent(product._id);
                                        link.setAttribute('role', 'option');
                                        if (product.imageUrl) {
                                            var image = document.createElement('img');
                                            image.src = product.imageUrl; image.alt = ''; link.appendChild(image);
                                        } else {
                                            var placeholder = document.createElement('span');
                                            placeholder.className = 'product-search-suggestion-image';
                                            placeholder.innerHTML = '<i class="bi bi-image" aria-hidden="true"></i>';
                                            link.appendChild(placeholder);
                                        }
                                        var name = document.createElement('span');
                                        name.className = 'product-search-suggestion-name'; name.textContent = product.name;
                                        link.appendChild(name);
                                        var arrow = document.createElement('i');
                                        arrow.className = 'bi bi-arrow-up-right'; arrow.setAttribute('aria-hidden', 'true');
                                        link.appendChild(arrow);
                                        dropdown.appendChild(link);
                                    });
                                    var more = document.createElement('button');
                                    more.type = 'submit'; more.className = 'product-search-suggestion-more'; more.textContent = 'Ver todos os resultados';
                                    dropdown.appendChild(more);
                                    dropdown.hidden = false;
                                }
                                input.addEventListener('input', function() {
                                    window.clearTimeout(timer);
                                    var query = input.value.trim();
                                    if (query.length < 2) { closeDropdown(); return; }
                                    timer = window.setTimeout(function() {
                                        fetch('/pesquisa/sugestoes?q=' + encodeURIComponent(query), { headers: { Accept: 'application/json' } })
                                            .then(function(response) { return response.json(); })
                                            .then(function(data) { render(data.products || []); })
                                            .catch(closeDropdown);
                                    }, 180);
                                });
                                input.addEventListener('focus', function() { if (dropdown.children.length) dropdown.hidden = false; });
                                document.addEventListener('click', function(event) { if (!widget.contains(event.target)) closeDropdown(); });
                            });
                        })();





