        script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js")
        script.
                        (function() {
                            var modal = document.querySelector('[data-scheduler-modal]');
                            var openButton = document.querySelector('[data-open-scheduler]');
                            if (!modal || !openButton) return;

                            var closeButton = modal.querySelector('[data-close-scheduler]');
                            var form = modal.querySelector('[data-scheduler-form]');
                            var dateInput = modal.querySelector('#scheduler-date');
                                                        var timeInput = modal.querySelector('#scheduler-time');
                                                        var weekLabel = modal.querySelector('[data-week-label]');
                                                        var daysContainer = modal.querySelector('[data-scheduler-days]');
                                                        var timesContainer = modal.querySelector('[data-scheduler-times]');
                                                        var currentWeek = new Date();
                            var feedback = modal.querySelector('[data-scheduler-feedback]');
                            var meetingHours = JSON.parse(modal.dataset.meetingHours || '[]');
                            var schedulerMeetings = JSON.parse(modal.dataset.schedulerMeetings || '[]');
                            var isAdminScheduler = modal.dataset.schedulerIsAdmin === 'true';
                            var submitButton = modal.querySelector('[data-scheduler-submit]');
                            var selectedTimesContainer = modal.querySelector('[data-selected-times]');
                            var selectedTimes = [];
                            var dayNames = ['DOM', 'SEG', 'TER', 'QUA', 'QUI', 'SEX', 'SAB'];
                            var timeGroups = [
                                { name: 'Manhã', times: meetingHours.filter(function(time) { return Number(time.slice(0, 2)) < 12; }) },
                                { name: 'Tarde', times: meetingHours.filter(function(time) { return Number(time.slice(0, 2)) >= 12 && Number(time.slice(0, 2)) < 18; }) },
                                { name: 'Noite', times: meetingHours.filter(function(time) { return Number(time.slice(0, 2)) >= 18; }) }
                            ].filter(function(group) { return group.times.length; });

                                                        function formatDate(date) {
                                                            var year = date.getFullYear();
                                                            var month = String(date.getMonth() + 1).padStart(2, '0');
                                                            var day = String(date.getDate()).padStart(2, '0');
                                                            return year + '-' + month + '-' + day;
                                                        }

                                                        function getStartOfWeek(date) {
                                                            var start = new Date(date);
                                                            start.setHours(0, 0, 0, 0);
                                                            start.setDate(start.getDate() - start.getDay());
                                                            return start;
                                                        }

                                                        function renderDays() {
                                                            var start = getStartOfWeek(currentWeek);
                                                            var today = formatDate(new Date());
                                                            daysContainer.innerHTML = '';
                                                            weekLabel.textContent = start.toLocaleDateString('pt-BR', { month: 'long', year: 'numeric' });

                                                            for (var index = 0; index < 7; index += 1) {
                                                                var date = new Date(start);
                                                                date.setDate(start.getDate() + index);
                                                                var dateValue = formatDate(date);
                                                                var dayButton = document.createElement('button');
                                                                dayButton.type = 'button';
                                                                dayButton.className = 'scheduler-day';
                                                                dayButton.dataset.date = dateValue;
                                                                dayButton.innerHTML = '<span>' + dayNames[date.getDay()] + '</span><strong>' + date.getDate() + '</strong>';
                                                                if (dateValue === today) dayButton.classList.add('is-today');
                                                                if (dateValue < today) {
                                                                    dayButton.disabled = true;
                                                                    dayButton.classList.add('is-disabled');
                                                                }
                                                                if (dateValue === dateInput.value) dayButton.classList.add('is-selected');
                                                                dayButton.addEventListener('click', function() {
                                                                    if (this.disabled) return;
                                                                    dateInput.value = this.dataset.date;
                                                                    selectedTimes = [];
                                                                    if (selectedTimesContainer) selectedTimesContainer.innerHTML = '';
                                                                    modal.querySelectorAll('.scheduler-day').forEach(function(button) {
                                                                        button.classList.remove('is-selected');
                                                                    });
                                                                    this.classList.add('is-selected');
                                                                    timeInput.value = '';
                                                                    if (submitButton) submitButton.textContent = isAdminScheduler ? 'Marcar horário como indisponível' : 'Solicitar reunião';
                                                                    form.action = isAdminScheduler ? '/reunioes/bloquear' : '/reunioes';
                                                                    renderTimes();
                                                                });
                                                                daysContainer.appendChild(dayButton);
                                                            }
                                                        }

                                                        function renderTimes() {
                                                            timesContainer.innerHTML = '';
                                                            timeGroups.forEach(function(group) {
                                                                var groupElement = document.createElement('section');
                                                                groupElement.className = 'scheduler-time-group';
                                                                groupElement.innerHTML = '<h3>' + group.name + '</h3><div class="scheduler-time-grid"></div>';
                                                                var grid = groupElement.querySelector('.scheduler-time-grid');
                                                                group.times.forEach(function(time) {
                                                                    var timeButton = document.createElement('button');
                                                                    timeButton.type = 'button';
                                                                    timeButton.className = 'scheduler-time';
                                                                    timeButton.textContent = time;
                                                                    timeButton.dataset.time = time;
                                                                    var slot = schedulerMeetings.find(function(meeting) { return meeting.date === dateInput.value && meeting.time === time; });
                                                                    var blockedByAdmin = slot && slot.status === 'unavailable';
                                                                    var bookedByClient = slot && !blockedByAdmin;
                                                                    var now = new Date();
                                                                    var selectedDate = dateInput.value;
                                                                    var today = formatDate(now);
                                                                    if (selectedDate < today || (selectedDate === today && time <= now.toTimeString().slice(0, 5)) || (bookedByClient && !isAdminScheduler) || (bookedByClient && isAdminScheduler)) {
                                                                        timeButton.disabled = true;
                                                                        timeButton.classList.add('is-disabled');
                                                                        if (bookedByClient) {
                                                                            timeButton.textContent = time + ' · Agendado';
                                                                            timeButton.title = 'Este horário já foi solicitado por um cliente.';
                                                                        }
                                                                    }
                                                                    if (blockedByAdmin) {
                                                                        if (isAdminScheduler) {
                                                                            timeButton.classList.add('is-blocked');
                                                                            timeButton.textContent = time + ' · Liberar';
                                                                        } else {
                                                                            timeButton.disabled = true;
                                                                            timeButton.classList.add('is-disabled');
                                                                            timeButton.title = 'Este horário está indisponível.';
                                                                        }
                                                                    }
                                                                    timeButton.addEventListener('click', function() {
                                                                        if (this.disabled) return;
                                                                        var selectedSlotIsBlocked = Boolean(blockedByAdmin && isAdminScheduler);
                                                                        if (isAdminScheduler && !selectedSlotIsBlocked) {
                                                                            var selectedIndex = selectedTimes.indexOf(this.dataset.time);
                                                                            if (selectedIndex === -1) selectedTimes.push(this.dataset.time);
                                                                            else selectedTimes.splice(selectedIndex, 1);
                                                                            this.classList.toggle('is-selected', selectedIndex === -1);
                                                                            timeInput.value = '';
                                                                            form.action = '/reunioes/bloquear';
                                                                            if (selectedTimesContainer) {
                                                                                selectedTimesContainer.innerHTML = '';
                                                                                selectedTimes.forEach(function(selectedTime) {
                                                                                    var input = document.createElement('input');
                                                                                    input.type = 'hidden'; input.name = 'times'; input.value = selectedTime;
                                                                                    selectedTimesContainer.appendChild(input);
                                                                                });
                                                                            }
                                                                            if (submitButton) submitButton.textContent = selectedTimes.length ? 'Indisponibilizar ' + selectedTimes.length + ' horário(s)' : 'Marcar horário como indisponível';
                                                                            return;
                                                                        }
                                                                        if (isAdminScheduler) {
                                                                            selectedTimes = [];
                                                                            if (selectedTimesContainer) selectedTimesContainer.innerHTML = '';
                                                                        }
                                                                        timeInput.value = this.dataset.time;
                                                                        form.action = isAdminScheduler && selectedSlotIsBlocked ? '/reunioes/desbloquear' : (isAdminScheduler ? '/reunioes/bloquear' : '/reunioes');
                                                                        if (submitButton) submitButton.textContent = isAdminScheduler ? (selectedSlotIsBlocked ? 'Liberar horário' : 'Marcar horário como indisponível') : 'Solicitar reunião';
                                                                        modal.querySelectorAll('.scheduler-time').forEach(function(button) {
                                                                            button.classList.remove('is-selected');
                                                                        });
                                                                        this.classList.add('is-selected');
                                                                    });
                                                                    grid.appendChild(timeButton);
                                                                });
                                                                timesContainer.appendChild(groupElement);
                                                            });
                                                        }

                            function closeModal() {
                                modal.classList.remove('is-visible');
                                modal.setAttribute('aria-hidden', 'true');
                                document.body.classList.remove('scheduler-open');
                                openButton.focus();
                            }

                            openButton.addEventListener('click', function() {
                                                                currentWeek = new Date();
                                                                dateInput.value = formatDate(new Date());
                                                                timeInput.value = '';
                                selectedTimes = [];
                                if (selectedTimesContainer) selectedTimesContainer.innerHTML = '';
                                form.action = isAdminScheduler ? '/reunioes/bloquear' : '/reunioes';
                                if (submitButton) submitButton.textContent = isAdminScheduler ? 'Marcar horário como indisponível' : 'Solicitar reunião';
                                feedback.textContent = '';
                                                                renderDays();
                                                                renderTimes();
                                modal.classList.add('is-visible');
                                modal.setAttribute('aria-hidden', 'false');
                                document.body.classList.add('scheduler-open');
                                                                modal.querySelector('.scheduler-day.is-selected').focus();
                            });

                                                        modal.querySelector('[data-previous-week]').addEventListener('click', function() {
                                                            currentWeek.setDate(currentWeek.getDate() - 7);
                                                            renderDays();
                                                        });
                                                        modal.querySelector('[data-next-week]').addEventListener('click', function() {
                                                            currentWeek.setDate(currentWeek.getDate() + 7);
                                                            renderDays();
                                                        });

                            closeButton.addEventListener('click', closeModal);
                            modal.addEventListener('click', function(event) {
                                if (event.target === modal) closeModal();
                            });
                            document.addEventListener('keydown', function(event) {
                                if (event.key === 'Escape' && modal.classList.contains('is-visible')) closeModal();
                            });
                            form.addEventListener('submit', function(event) {
                                var isBlockingMultiple = isAdminScheduler && form.action.indexOf('/reunioes/bloquear') !== -1 && selectedTimes.length > 0;
                                if (!dateInput.value || (!isBlockingMultiple && !timeInput.value)) {
                                    event.preventDefault();
                                    feedback.textContent = isAdminScheduler ? 'Escolha uma data e pelo menos um horário.' : 'Escolha uma data e um horário.';
                                }
                            });
                        })();
                        (function() {
                            var navbar = document.querySelector('.navbar-encantado');
                            var loginImage = document.querySelector('.login-image');
                            if (!navbar || !loginImage || !('IntersectionObserver' in window)) return;

                            var observer = new IntersectionObserver(function(entries) {
                                navbar.classList.toggle('navbar-login-hidden', entries[0].isIntersecting);
                            }, { threshold: 0.1 });
                            observer.observe(loginImage);
                        })();
                        (function() {
                            var carousel = document.querySelector('[data-catalog-carousel]');
                            if (!carousel) return;

                            var slides = Array.prototype.slice.call(carousel.querySelectorAll('[data-catalog-slide]'));
                            var currentIndex = 0;
                            var touchStartX = 0;
                            var touchStartY = 0;
                            var isTouching = false;
                            var isHorizontalDrag = false;
                            var dragSuppressedUntil = 0;
                            var DRAG_START_THRESHOLD = 10;
                            var DRAG_DISTANCE = 40;

                            function updateCarousel(nextIndex) {
                                currentIndex = Math.max(0, Math.min(nextIndex, slides.length - 1));
                                slides.forEach(function(slide, index) {
                                    var distance = index - currentIndex;
                                    slide.classList.remove('is-active', 'is-before', 'is-after', 'is-far-before', 'is-far-after', 'is-farthest-before', 'is-farthest-after');
                                    if (index === currentIndex) slide.classList.add('is-active');
                                    if (distance === -1) slide.classList.add('is-before');
                                    if (distance === 1) slide.classList.add('is-after');
                                    if (distance === -2) slide.classList.add('is-far-before');
                                    if (distance === 2) slide.classList.add('is-far-after');
                                    if (distance === -3) slide.classList.add('is-farthest-before');
                                    if (distance === 3) slide.classList.add('is-farthest-after');
                                });
                            }

                            // Arrasto com o dedo (touch) para trocar o card ativo, principalmente em telas menores.
                            carousel.addEventListener('touchstart', function(event) {
                                if (event.touches.length !== 1) return;
                                isTouching = true;
                                isHorizontalDrag = false;
                                touchStartX = event.touches[0].clientX;
                                touchStartY = event.touches[0].clientY;
                            }, { passive: true });

                            carousel.addEventListener('touchmove', function(event) {
                                if (!isTouching || event.touches.length !== 1) return;
                                var deltaX = event.touches[0].clientX - touchStartX;
                                var deltaY = event.touches[0].clientY - touchStartY;
                                if (!isHorizontalDrag && Math.abs(deltaX) > DRAG_START_THRESHOLD && Math.abs(deltaX) > Math.abs(deltaY)) {
                                    isHorizontalDrag = true;
                                }
                                // Só bloqueia a rolagem da página quando o gesto é claramente horizontal.
                                if (isHorizontalDrag && event.cancelable) event.preventDefault();
                            }, { passive: false });

                            carousel.addEventListener('touchend', function(event) {
                                if (!isTouching) return;
                                isTouching = false;
                                if (!isHorizontalDrag || !event.changedTouches || !event.changedTouches.length) return;
                                var deltaX = event.changedTouches[0].clientX - touchStartX;
                                // Marca o clique que o navegador dispara logo depois do arrasto para não navegar.
                                dragSuppressedUntil = Date.now() + 500;
                                if (Math.abs(deltaX) >= DRAG_DISTANCE) updateCarousel(currentIndex + (deltaX < 0 ? 1 : -1));
                            });

                            carousel.addEventListener('touchcancel', function() {
                                isTouching = false;
                                isHorizontalDrag = false;
                            });

                            slides.forEach(function(slide, index) {
                                slide.addEventListener('click', function(event) {
                                    if (Date.now() < dragSuppressedUntil) {
                                        event.preventDefault();
                                        event.stopPropagation();
                                        return;
                                    }
                                    if (this.classList.contains('is-active')) return;

                                    event.preventDefault();
                                    updateCarousel(index);
                                });
                            });
                            updateCarousel(0);
                        })();
                        (function() {
                            var toggle = document.querySelector('[data-theme-toggle]');
                            if (!toggle) return;

                            var icon = toggle.querySelector('i');

                            function applyTheme(isDark) {
                                document.body.classList.toggle('dark-mode', isDark);
                                toggle.setAttribute('aria-pressed', String(isDark));
                                toggle.setAttribute('aria-label', isDark ? 'Ativar modo claro' : 'Ativar modo escuro');
                                toggle.setAttribute('title', isDark ? 'Modo claro' : 'Modo escuro');
                                icon.className = isDark ? 'bi bi-sun-fill' : 'bi bi-moon-stars-fill';
                            }

                            var savedTheme = window.localStorage.getItem('espaco-encantado-theme');
                            applyTheme(savedTheme === 'dark');
                            toggle.addEventListener('click', function() {
                                var isDark = !document.body.classList.contains('dark-mode');
                                applyTheme(isDark);
                                window.localStorage.setItem('espaco-encantado-theme', isDark ? 'dark' : 'light');
                            });
                        })();
                        (function() {
                            var widgets = document.querySelectorAll('[data-product-search-widget]');
                            widgets.forEach(function(widget) {
                                var input = widget.querySelector('[data-product-search-input]');
                                var dropdown = widget.querySelector('[data-product-search-suggestions]');
                                if (!input || !dropdown) return;
                                var timer;
                                function closeDropdown() { dropdown.hidden = true; dropdown.innerHTML = ''; }
                                function render(products) {
                                    dropdown.innerHTML = '';
                                    if (!products.length) { closeDropdown(); return; }
                                    products.slice(0, 3).forEach(function(product) {
                                        var link = document.createElement('a');
                                        link.className = 'product-search-suggestion';
                                        link.href = '/produto/' + encodeURIComponent(product._id);
                                        link.setAttribute('role', 'option');
                                        if (product.imageUrl) {
                                            var image = document.createElement('img');
                                            image.src = product.imageUrl; image.alt = ''; link.appendChild(image);
                                        } else {
                                            var placeholder = document.createElement('span');
                                            placeholder.className = 'product-search-suggestion-image';
                                            placeholder.innerHTML = '<i class="bi bi-image" aria-hidden="true"></i>';
                                            link.appendChild(placeholder);
                                        }
                                        var name = document.createElement('span');
                                        name.className = 'product-search-suggestion-name'; name.textContent = product.name;
                                        link.appendChild(name);
                                        var arrow = document.createElement('i');
                                        arrow.className = 'bi bi-arrow-up-right'; arrow.setAttribute('aria-hidden', 'true');
                                        link.appendChild(arrow);
                                        dropdown.appendChild(link);
                                    });
                                    var more = document.createElement('button');
                                    more.type = 'submit'; more.className = 'product-search-suggestion-more'; more.textContent = 'Ver todos os resultados';
                                    dropdown.appendChild(more);
                                    dropdown.hidden = false;
                                }
                                input.addEventListener('input', function() {
                                    window.clearTimeout(timer);
                                    var query = input.value.trim();
                                    if (query.length < 2) { closeDropdown(); return; }
                                    timer = window.setTimeout(function() {
                                        fetch('/pesquisa/sugestoes?q=' + encodeURIComponent(query), { headers: { Accept: 'application/json' } })
                                            .then(function(response) { return response.json(); })
                                            .then(function(data) { render(data.products || []); })
                                            .catch(closeDropdown);
                                    }, 180);
                                });
                                input.addEventListener('focus', function() { if (dropdown.children.length) dropdown.hidden = false; });
                                document.addEventListener('click', function(event) { if (!widget.contains(event.target)) closeDropdown(); });
                            });
                        })();
                        (function() {
                            var favoriteState = document.querySelector('[data-favorite-ids]');
                            if (!favoriteState) return;
                            var favoriteIds = JSON.parse(favoriteState.dataset.favoriteIds || '[]');
                            var favoritesOnly = document.querySelector('[data-favorites-only="true"]');
                            var favoriteGrid = favoritesOnly && document.querySelector('[data-catalog-grid]');
                            var favoriteButtons = Array.prototype.slice.call(document.querySelectorAll('[data-favorite]'));

                            function setFavoriteButton(button, active) {
                                button.setAttribute('aria-pressed', String(active));
                                button.classList.toggle('is-favorite', active);
                                button.title = active ? 'Remover dos favoritos' : 'Favoritar';
                            }

                            favoriteButtons.forEach(function(button) {
                                setFavoriteButton(button, favoriteIds.indexOf(button.dataset.favorite) !== -1);
                                button.addEventListener('click', function() {
                                    var productId = button.dataset.favorite;
                                    button.disabled = true;
                                    fetch('/favoritos/toggle', {
                                        method: 'POST',
                                        headers: { Accept: 'application/json', 'Content-Type': 'application/x-www-form-urlencoded' },
                                        body: new URLSearchParams({ productId: productId, returnTo: window.location.pathname + window.location.search })
                                    }).then(function(response) {
                                        return response.json().then(function(result) { return { ok: response.ok, result: result }; });
                                    }).then(function(data) {
                                        if (data.result.loginUrl) { window.location.href = data.result.loginUrl; return; }
                                        if (!data.ok) throw new Error(data.result.message || 'Não foi possível atualizar os favoritos.');
                                        var active = data.result.favorited;
                                        favoriteIds = favoriteIds.filter(function(id) { return id !== productId; });
                                        if (active) favoriteIds.push(productId);
                                        favoriteState.dataset.favoriteIds = JSON.stringify(favoriteIds);
                                        favoriteButtons.forEach(function(item) { if (item.dataset.favorite === productId) setFavoriteButton(item, active); });
                                        if (favoritesOnly && !active) {
                                            var card = button.closest('[data-favorite-product]');
                                            if (card) card.remove();
                                            if (favoriteGrid && !favoriteGrid.querySelector('.catalog-product-card')) {
                                                var empty = favoriteGrid.querySelector('[data-catalog-empty]');
                                                if (!empty) {
                                                    empty = document.createElement('p');
                                                    empty.className = 'catalog-empty';
                                                    empty.setAttribute('data-catalog-empty', '');
                                                    favoriteGrid.appendChild(empty);
                                                }
                                                empty.textContent = 'Você ainda não favoritou produtos.';
                                                empty.hidden = false;
                                            }
                                        }
                                    }).catch(function(error) {
                                        if (error && error.message) window.alert(error.message);
                                    }).finally(function() { button.disabled = false; });
                                });
                            });
                        })();

