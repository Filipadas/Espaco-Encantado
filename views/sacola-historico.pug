extends layout

block content
  main.admin-page
    a.admin-back-link(href='/perfil')
      i.bi.bi-arrow-left
      | Meu perfil
    p.admin-eyebrow MINHAS SOLICITAÇÕES
    h1.admin-title Histórico de solicitações
    if rentals && rentals.length
      .admin-table-wrap
        table.admin-table
          thead
            tr
              th Datas
              th Itens
              th Status
              th Comprovante
          tbody
            each rental in rentals
              tr
                td(data-label='Datas')= rental.dates.join(' | ')
                td(data-label='Itens')
                  each item in rental.items
                    div #{item.quantity}x #{item.name}
                td(data-label='Status')= rental.status === 'analysis' ? 'Em análise' : rental.status === 'active' ? 'Ativo' : rental.status === 'returned' ? 'Devolvido' : rental.status === 'cancelled' ? 'Cancelado' : rental.status
                td(data-label='Comprovante')
                  a.admin-small-button(href='/sacola/comprovante/' + rental._id) Visualizar comprovante
    else
      .admin-empty
        i.bi.bi-clock-history
        p Você ainda não realizou solicitações.
