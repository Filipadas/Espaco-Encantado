doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title Recuperar senha | Espaço Encantado
    link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css')
    link(rel='stylesheet' href='/stylesheets/style.css?v=20261017-produto-mobile')
  body.delete-account-page
    main.confirmation-page
      .confirmation-card
        img.auth-logo(src='/images/logo_ee.png' alt='Espaço Encantado')
        h1.admin-title Digite o código
        p.admin-subtitle Insira o código enviado para #{email}.
        if formError
          p.admin-form-error= formError
        form.admin-form(method='post' action='/recuperar-senha/codigo')
          input(type='hidden' name='email' value=email)
          input(type='hidden' name='returnTo' value=returnTo || '/')
          label(for='recovery-code') Código de verificação
          input#recovery-code(type='text' name='code' required maxlength='5' pattern='[0-9]{5}' placeholder='12345' autocomplete='one-time-code')
          .profile-actions
            a.admin-small-button.confirm-cancel-button(href='/recuperar-senha') Voltar
            button.admin-primary-button(type='submit') Verificar código