extends layout

mixin catalogProductCard(product)
  article.catalog-product-card(data-product-id=product._id data-favorite-product=product._id)
    .catalog-product-photo
      if product.imageUrl
        img(src=product.imageUrl alt='Foto de ' + product.name)
      else
        span Foto
    .catalog-product-summary
      h2.catalog-product-name= product.name
      p.catalog-product-price R$ #{Number(product.price).toFixed(2).replace('.', ',')}
      p.catalog-product-description= product.description || 'Produto disponível para sua festa.'
    button.catalog-card-toggle(type='button' aria-label='Ver detalhes de ' + product.name aria-expanded='false')
      i.bi.bi-chevron-up(aria-hidden='true')
    .catalog-product-details
      h2.catalog-product-name= product.name
      p.catalog-product-price R$ #{Number(product.price).toFixed(2).replace('.', ',')}
      .catalog-product-actions
        button.catalog-icon-button(type='button' data-favorite=product._id aria-label='Favoritar ' + product.name aria-pressed='false' title='Favoritar')
          i.bi.bi-heart(aria-hidden='true')
        form(method='post' action='/sacola/adicionar' data-cart-form)
          input(type='hidden' name='productId' value=product._id)
          button.catalog-icon-button(type='submit' aria-label='Adicionar ' + product.name + ' à sacola' title='Adicionar à sacola')
            i.bi.bi-bag-plus(aria-hidden='true')

block content
  - var stateCategories = { brinquedos: 'brinquedo', decoracoes: 'decoração', 'kit-montagem': 'kit-mont', infantil: 'infantil' }
  - var activeState = stateCategories[selectedState] ? selectedState : 'brinquedos'
  - var activeCategory = stateCategories[activeState]
  - var categoryTitles = { brinquedo: 'Brinquedos', decoração: 'Decorações', 'kit-mont': 'Kit de montagem', infantil: 'Festa infantil' }
  - var catalogSubcategoryRows = Array.isArray(subcategoryRows) ? subcategoryRows : []
  - var catalogProducts = Array.isArray(products) ? products : []
  main.catalog-page
    aside.catalog-sidebar(aria-label='Categorias do catálogo' data-catalog-sidebar data-initial-state=activeState data-initial-category=activeCategory)
      nav.catalog-sidebar-nav
        if favoritesOnly
          a.catalog-sidebar-item.is-selected.active(href='/favoritos' aria-label='Favoritos')
            i.bi.bi-heart-fill(aria-hidden='true')
            span.catalog-sidebar-label Favoritos
          a.catalog-sidebar-item(href='/catalogo?estado=brinquedos' aria-label='Voltar ao catálogo')
            i.bi.bi-grid-3x3-gap-fill(aria-hidden='true')
            span.catalog-sidebar-label Catálogo
        else
          button.catalog-sidebar-item(class=activeState === 'brinquedos' ? 'is-selected active' : '' type='button' aria-label='Brinquedos' data-catalog-state='brinquedos' data-catalog-category='brinquedo')
            img.catalog-sidebar-icon(src='/images/icone_trampolim.png' alt='')
            span.catalog-sidebar-label Brinquedos
          button.catalog-sidebar-item(class=activeState === 'decoracoes' ? 'is-selected active' : '' type='button' aria-label='Decorações' data-catalog-state='decoracoes' data-catalog-category='decoração')
            img.catalog-sidebar-icon(src='/images/icone_balao.png' alt='')
            span.catalog-sidebar-label Decorações
          button.catalog-sidebar-item(class=activeState === 'kit-montagem' ? 'is-selected active' : '' type='button' aria-label='Kit de montagem' data-catalog-state='kit-montagem' data-catalog-category='kit-mont')
            img.catalog-sidebar-icon(src='/images/icone_bolo.png' alt='')
            span.catalog-sidebar-label Kit de montagem
          button.catalog-sidebar-item(class=activeState === 'festa-infantil' ? 'is-selected active' : '' type='button' aria-label='Festa infantil' data-catalog-state='festa-infantil' data-catalog-category='infantil')
            img.catalog-sidebar-icon(src='/images/icone_feliz.png' alt='')
            span.catalog-sidebar-label Festa infantil
      button.catalog-sidebar-toggle(type='button' aria-label='Expandir categorias' aria-expanded='false' data-catalog-sidebar-toggle)
        i.bi.bi-chevron-right(aria-hidden='true')

    section.catalog-page-content
      img.catalog-hero-image(src='/images/baloes_catalogo.png' alt='Balões decorativos do catálogo')
      section.catalog-products(aria-labelledby='catalog-products-title' data-favorites-only=favoritesOnly ? 'true' : 'false')
        if favoritesOnly
          h1#catalog-products-title.catalog-products-title Favoritos
        else if listingMode
          h1#catalog-products-title.catalog-products-title= categoryTitle + ' — ' + selectedSubcategoryTitle
        else
          h1#catalog-products-title.catalog-products-title= categoryTitle
        form.catalog-search.catalog-page-search(role='search' data-catalog-search-form)
          input.form-control(type='search' placeholder='Pesquisar produtos' aria-label='Pesquisar produtos' data-catalog-search)
        if favoritesOnly || listingMode
          .catalog-products-grid(data-catalog-grid)
            each product in products
              +catalogProductCard(product)
            else
              p.catalog-empty(data-catalog-empty) Nenhum produto encontrado.
        else
          .catalog-product-rows
            section.catalog-product-row.catalog-product-row-general(data-catalog-row)
              .catalog-product-row-track
                each product in catalogProducts.slice(0, 8)
                  +catalogProductCard(product)
                if catalogProducts.length
                  a.catalog-more-card(href='/catalogo/' + activeState + '/geral')
                    i.bi.bi-arrow-right-circle(aria-hidden='true')
                    span Ver mais produtos
              if !catalogProducts.length
                p.catalog-empty Nenhum produto cadastrado nesta categoria.
            each row in catalogSubcategoryRows
              section.catalog-product-row(data-catalog-row)
                h2.catalog-subcategory-title= row.name
                .catalog-product-row-track
                  each product in row.products.slice(0, 8)
                    +catalogProductCard(product)
                  a.catalog-more-card(href='/catalogo/' + activeState + '/' + row.slug)
                    i.bi.bi-arrow-right-circle(aria-hidden='true')
                    span Ver mais em #{row.name}
          p.catalog-empty(data-catalog-search-empty hidden) Nenhum produto corresponde à pesquisa.

  script.
    (function() {
      var sidebar = document.querySelector('[data-catalog-sidebar]');
      var toggle = document.querySelector('[data-catalog-sidebar-toggle]');
      if (!sidebar || !toggle) return;

      toggle.addEventListener('click', function() {
        var isExpanded = sidebar.classList.toggle('is-expanded');
        toggle.setAttribute('aria-expanded', String(isExpanded));
        toggle.setAttribute('aria-label', isExpanded ? 'Recolher categorias' : 'Expandir categorias');
      });

      var categoryButtons = Array.prototype.slice.call(document.querySelectorAll('[data-catalog-state]'));
      var title = document.querySelector('.catalog-products-title');
      var catalogCategories = {
        brinquedos: { category: 'brinquedo', title: 'Brinquedos' },
        decoracoes: { category: 'decoração', title: 'Decorações' },
        'kit-montagem': { category: 'kit-mont', title: 'Kit de montagem' },
        'festa-infantil': { category: 'infantil', title: 'Festa infantil' }
      };
      categoryButtons.forEach(function(button) {
        button.addEventListener('click', function() { window.location.href = '/catalogo?estado=' + encodeURIComponent(this.dataset.catalogState); });
      });
      var selectedState = new URLSearchParams(window.location.search).get('estado');
      if (selectedState && catalogCategories[selectedState] && title && !document.querySelector('[data-favorites-only="true"]')) {
        title.textContent = catalogCategories[selectedState].title;
      }

      var productsOnly = document.querySelector('[data-favorites-only]').dataset.favoritesOnly === 'true';
      var savedFavorites = JSON.parse(localStorage.getItem('espaco-encantado-favorites') || '[]');
      if (productsOnly) {
        document.querySelectorAll('[data-favorite-product]').forEach(function(card) {
          if (savedFavorites.indexOf(card.dataset.favoriteProduct) === -1) card.remove();
        });
        if (!document.querySelector('[data-favorite-product]')) {
          var emptyFavorites = document.querySelector('[data-catalog-empty]');
          if (emptyFavorites) emptyFavorites.textContent = 'Você ainda não favoritou produtos.';
          else {
            emptyFavorites = document.createElement('p');
            emptyFavorites.className = 'catalog-empty';
            emptyFavorites.textContent = 'Você ainda não favoritou produtos.';
            document.querySelector('.catalog-products-grid').appendChild(emptyFavorites);
          }
        }
      }

      var search = document.querySelector('[data-catalog-search]');
      if (search) search.addEventListener('input', function() {
        var query = search.value.trim().toLocaleLowerCase();
        document.querySelectorAll('[data-catalog-row]').forEach(function(row) {
          var cards = Array.prototype.slice.call(row.querySelectorAll('.catalog-product-card'));
          var visibleCount = 0;
          cards.forEach(function(card) {
            var visible = !query || card.textContent.toLocaleLowerCase().indexOf(query) !== -1;
            card.hidden = !visible;
            if (visible) visibleCount += 1;
          });
          row.hidden = visibleCount === 0;
        });
        var searchEmpty = document.querySelector('[data-catalog-search-empty]');
        if (searchEmpty) {
          var visibleRows = Array.prototype.slice.call(document.querySelectorAll('[data-catalog-row]')).some(function(row) { return !row.hidden; });
          searchEmpty.hidden = !query || visibleRows;
        }
        var grid = document.querySelector('[data-catalog-grid]');
        if (grid) {
          var visibleCards = Array.prototype.slice.call(grid.querySelectorAll('.catalog-product-card')).filter(function(card) {
            var visible = !query || card.textContent.toLocaleLowerCase().indexOf(query) !== -1;
            card.hidden = !visible;
            return visible;
          });
          var empty = grid.querySelector('[data-catalog-empty]');
          if (!empty && !visibleCards.length) {
            empty = document.createElement('p');
            empty.className = 'catalog-empty';
            empty.setAttribute('data-catalog-empty', '');
            grid.appendChild(empty);
          }
          if (empty) {
            empty.hidden = visibleCards.length > 0;
            empty.textContent = productsOnly && !query && !savedFavorites.length ? 'Você ainda não favoritou produtos.' : 'Nenhum produto encontrado.';
          }
        }
      });

      document.querySelectorAll('[data-favorite-product]').forEach(function(card) {
        card.addEventListener('click', function(event) {
          if (event.target.closest('button, form, a')) return;
          window.location.href = '/produto/' + card.dataset.productId;
        });
      });
      document.querySelectorAll('[data-cart-form]').forEach(function(form) {
        form.addEventListener('submit', function(event) {
          event.preventDefault();
          fetch(form.action, { method: 'POST', body: new URLSearchParams(new FormData(form)), headers: { Accept: 'application/json', 'X-Cart-Request': 'json' } })
            .then(function(response) {
              if (response.url.indexOf('/entrar') !== -1) return window.location.href = response.url;
              return response.json().then(function(result) { return { ok: response.ok, result: result }; });
            })
            .then(function(data) { if (data && data.result && data.result.message) window.alert(data.result.message); })
            .catch(function() { window.alert('Não foi possível adicionar o produto à sacola.'); });
        });
      });
      document.querySelectorAll('.catalog-card-toggle').forEach(function(button) {
        button.addEventListener('click', function() {
          var card = button.closest('.catalog-product-card');
          var expanded = card.classList.toggle('is-expanded');
          button.setAttribute('aria-expanded', String(expanded));
        });
      });
      document.querySelectorAll('[data-favorite]').forEach(function(button) {
        var id = button.dataset.favorite;
        var active = savedFavorites.indexOf(id) !== -1;
        button.setAttribute('aria-pressed', String(active));
        button.classList.toggle('is-favorite', active);
        button.addEventListener('click', function() {
          var position = savedFavorites.indexOf(id);
          if (position === -1) savedFavorites.push(id);
          else savedFavorites.splice(position, 1);
          localStorage.setItem('espaco-encantado-favorites', JSON.stringify(savedFavorites));
          var selected = savedFavorites.indexOf(id) !== -1;
          button.setAttribute('aria-pressed', String(selected));
          button.classList.toggle('is-favorite', selected);
        });
      });
    })();
