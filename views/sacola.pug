extends layout

block content
  main.admin-page.cart-page
    a.admin-small-button.profile-back-link(href='javascript:history.back()' aria-label='Voltar' title='Voltar')
      i.bi.bi-arrow-left(aria-hidden='true')
    p.admin-eyebrow MINHA CONTA
    h1.admin-title Minha sacola
    .cart-confirm-overlay(data-cart-confirm-overlay hidden=!pendingRequest)
      .confirmation-card
        img.auth-logo(src='/images/logo_ee.png' alt='Espaço Encantado')
        h1.admin-title Você enviou a mensagem de solicitação?
        p.admin-subtitle A solicitação só será enviada para a loja e os produtos sairão da sacola depois que você confirmar o envio da mensagem no WhatsApp.
        if pendingWhatsappUrl
          a.admin-small-button.cart-confirm-whatsapp(href=pendingWhatsappUrl target='_blank' rel='noopener')
            i.bi.bi-whatsapp(aria-hidden='true')
            | Abrir WhatsApp novamente
        .profile-actions
          form(method='post' action='/sacola/solicitar/cancelar')
            button.admin-small-button.confirm-cancel-button(type='submit') Não, ainda não
          form(method='post' action='/sacola/solicitar/confirmar')
            button.admin-primary-button(type='submit') Sim, já enviei
    if rentalSuccess
      p.admin-success Solicitação registrada e enviada para análise. Você pode acompanhar o andamento no histórico.
    if cartError
      p.admin-form-error= cartError
    if cart && cart.length
      .cart-list
        each item, cartIndex in cart
          .cart-item(data-cart-item data-name=item.name data-quantity=item.quantity data-price=item.price data-request-date=item.requestDate)
            a.cart-item-product-link(href='/produto/' + item.productId)
              .cart-item-photo
                if item.imageUrl
                  img(src=item.imageUrl alt='Foto de ' + item.name)
                else
                  i.bi.bi-image(aria-hidden='true')
            .cart-item-info
              a(href='/produto/' + item.productId)
                strong #{item.quantity}x #{item.name}
              if item.customText
                p.cart-item-custom-text Texto a personalizar: #{item.customText}
              label Data de utilização
              form.cart-date-form(method='post' action='/sacola/data' data-cart-date-form)
                input(type='hidden' name='productId' value=item.productId)
                input(type='hidden' name='customText' value=item.customText || '')
                input(type='hidden' name='date' value=item.requestDate data-cart-date-value)
                if item.requestDate
                  .cart-date-picker(data-cart-date-picker data-unavailable-dates=JSON.stringify(item.unavailableDates || []) data-selected-date=item.requestDate data-min-date=minimumDate)
                    button.cart-date-trigger(type='button' data-cart-date-trigger aria-haspopup='dialog' aria-expanded='false')
                      i.bi.bi-calendar-event(aria-hidden='true')
                      span(data-cart-date-label)= item.requestDate.split('-').reverse().join('/')
                      i.bi.bi-chevron-down(aria-hidden='true')
                    .cart-calendar(data-cart-calendar role='dialog' aria-label='Escolha a data de utilização' hidden)
                      .cart-calendar-header
                        button.cart-calendar-nav(type='button' data-cart-calendar-prev aria-label='Mês anterior')
                          i.bi.bi-chevron-left(aria-hidden='true')
                        strong.cart-calendar-title(data-cart-calendar-title)
                        button.cart-calendar-nav(type='button' data-cart-calendar-next aria-label='Próximo mês')
                          i.bi.bi-chevron-right(aria-hidden='true')
                      .cart-calendar-weekdays
                        each weekday in ['DOM', 'SEG', 'TER', 'QUA', 'QUI', 'SEX', 'SÁB']
                          span= weekday
                      .cart-calendar-grid(data-cart-calendar-grid)
                      p.cart-calendar-legend
                        span.cart-calendar-legend-item
                          span.cart-calendar-dot.is-available
                          | Disponível
                        span.cart-calendar-legend-item
                          span.cart-calendar-dot.is-unavailable
                          | Indisponível
                else
                  span.cart-date-unavailable Nenhuma data disponível para este produto.
            strong R$ #{(Number(item.price) * item.quantity).toFixed(2).replace('.', ',')}
            .cart-quantity-actions
              form(method='post' action='/sacola/ajustar')
                input(type='hidden' name='productId' value=item.productId)
                input(type='hidden' name='customText' value=item.customText || '')
                input(type='hidden' name='delta' value='-1')
                button.cart-quantity-button(type='submit' aria-label='Remover uma unidade' title='Remover uma unidade')
                  i.bi.bi-dash-lg(aria-hidden='true')
              span= item.quantity
              form(method='post' action='/sacola/ajustar')
                input(type='hidden' name='productId' value=item.productId)
                input(type='hidden' name='customText' value=item.customText || '')
                input(type='hidden' name='delta' value='1')
                button.cart-quantity-button(type='submit' aria-label='Adicionar uma unidade' title='Adicionar uma unidade')
                  i.bi.bi-plus-lg(aria-hidden='true')
      form(method='post' action='/sacola/solicitar' target='_blank' rel='noopener' data-submit-once)
        h2 Dados da entrega
        .auth-field
          label(for='saved-delivery-address') Usar endereço salvo
          select#saved-delivery-address
            option(value='') Digitar outro endereço
            if deliveryProfile && deliveryProfile.address
              option(value=JSON.stringify({ address: deliveryProfile.address, city: deliveryProfile.city, state: deliveryProfile.state, cep: deliveryProfile.cep }) selected) Endereço principal
            each savedAddress, index in (deliveryProfile && deliveryProfile.addresses || [])
              option(value=JSON.stringify({ address: savedAddress.address, city: savedAddress.city, state: savedAddress.state, cep: savedAddress.cep }) selected=(!deliveryProfile.address && index === 0 ? true : undefined))= savedAddress.label || ('Endereço salvo ' + (index + 1))
        .register-location-fields
          .auth-field
            label(for='delivery-address') Endereço
            input#delivery-address(type='text' name='deliveryAddress' autocomplete='street-address' required value=(deliveryProfile && deliveryProfile.address) || '')
          .auth-field
            label(for='delivery-city') Cidade
            input#delivery-city(type='text' name='deliveryCity' autocomplete='address-level2' required value=(deliveryProfile && deliveryProfile.city) || '')
          .auth-field
            label(for='delivery-state') UF
            input#delivery-state(type='text' name='deliveryState' maxlength='2' pattern='[A-Za-z]{2}' autocomplete='address-level1' required value=(deliveryProfile && deliveryProfile.state) || '')
          .auth-field
            label(for='delivery-cep') CEP
            input#delivery-cep(type='text' name='deliveryCep' autocomplete='postal-code' required value=(deliveryProfile && deliveryProfile.cep) || '')
          .auth-field
            label(for='delivery-date') Data prevista da entrega
            input#delivery-date(type='date' name='deliveryDate' required)
          .auth-field
            label(for='delivery-time') Horário previsto da entrega
            input#delivery-time(type='time' name='deliveryTime' required)
        label.salon-rental-check
          input(type='checkbox' name='salonRental' data-salon-toggle)
          | Desejo alugar também o horário do salão
        button.admin-primary-button(type='submit' data-submit-once-button)
          i.bi.bi-calendar-check(aria-hidden='true')
          | Enviar solicitação
        .salon-rental-drawer(data-salon-drawer hidden)
          label(for='salon-date') Dia do salão
          input#salon-date(type='date' name='salonDate')
          label(for='salon-time') Horário do salão
          input#salon-time(type='time' name='salonTime')
      form(method='post' action='/sacola/limpar')
        button.admin-danger-button(type='submit') Esvaziar sacola
    else
      .admin-empty
        i.bi.bi-bag
        p Sua sacola está vazia.
        a.admin-primary-button(href='/catalogo') Explorar catálogo
  script.
    (function() {
    var savedAddress = document.querySelector('#saved-delivery-address');
    if (savedAddress) savedAddress.addEventListener('change', function() {
      if (!savedAddress.value) {
        document.querySelector('#delivery-address').value = '';
        document.querySelector('#delivery-city').value = '';
        document.querySelector('#delivery-state').value = '';
        document.querySelector('#delivery-cep').value = '';
        return;
      }
      try {
        var address = JSON.parse(savedAddress.value);
        document.querySelector('#delivery-address').value = address.address || '';
        document.querySelector('#delivery-city').value = address.city || '';
        document.querySelector('#delivery-state').value = address.state || '';
        document.querySelector('#delivery-cep').value = address.cep || '';
      } catch (error) {}
    });
    if (savedAddress && savedAddress.value) savedAddress.dispatchEvent(new Event('change'));
      var monthNames = ['Janeiro', 'Fevereiro', 'Março', 'Abril', 'Maio', 'Junho', 'Julho', 'Agosto', 'Setembro', 'Outubro', 'Novembro', 'Dezembro'];
      function padDatePart(value) { return String(value).padStart(2, '0'); }
      function localDateKey(date) { return date.getFullYear() + '-' + padDatePart(date.getMonth() + 1) + '-' + padDatePart(date.getDate()); }
      function parseDateKey(value) {
        var parts = String(value || '').split('-');
        return parts.length === 3 ? new Date(Number(parts[0]), Number(parts[1]) - 1, Number(parts[2])) : new Date();
      }
      function formatDateKey(value) {
        var parts = String(value || '').split('-');
        return parts.length === 3 ? parts[2] + '/' + parts[1] + '/' + parts[0] : '';
      }
      var cartDatePickers = document.querySelectorAll('[data-cart-date-picker]');
      function closeCartCalendars(except) {
        cartDatePickers.forEach(function(picker) {
          if (picker === except) return;
          var calendar = picker.querySelector('[data-cart-calendar]');
          var trigger = picker.querySelector('[data-cart-date-trigger]');
          if (calendar) calendar.hidden = true;
          if (trigger) trigger.setAttribute('aria-expanded', 'false');
        });
      }
      cartDatePickers.forEach(function(picker) {
        var form = picker.closest('form');
        var trigger = picker.querySelector('[data-cart-date-trigger]');
        var calendar = picker.querySelector('[data-cart-calendar]');
        var title = picker.querySelector('[data-cart-calendar-title]');
        var grid = picker.querySelector('[data-cart-calendar-grid]');
        var label = picker.querySelector('[data-cart-date-label]');
        var previous = picker.querySelector('[data-cart-calendar-prev]');
        var next = picker.querySelector('[data-cart-calendar-next]');
        var dateInput = form ? form.querySelector('[name="date"]') : null;
        if (!form || !trigger || !calendar || !title || !grid || !label || !previous || !next || !dateInput) return;
        var unavailable = [];
        try { unavailable = JSON.parse(picker.dataset.unavailableDates || '[]'); } catch (error) { unavailable = []; }
        var selectedDate = picker.dataset.selectedDate || '';
        var minimumDate = picker.dataset.minDate || localDateKey(new Date());
        var today = localDateKey(new Date());
        var viewDate = parseDateKey(selectedDate || minimumDate);
        viewDate = new Date(viewDate.getFullYear(), viewDate.getMonth(), 1);

        function renderCalendar() {
          title.textContent = monthNames[viewDate.getMonth()] + ' ' + viewDate.getFullYear();
          grid.innerHTML = '';
          var firstDay = new Date(viewDate.getFullYear(), viewDate.getMonth(), 1);
          var startDay = new Date(firstDay.getFullYear(), firstDay.getMonth(), firstDay.getDate() - firstDay.getDay());
          for (var index = 0; index < 42; index += 1) {
            var day = new Date(startDay.getFullYear(), startDay.getMonth(), startDay.getDate() + index);
            var key = localDateKey(day);
            var blocked = key < minimumDate || unavailable.indexOf(key) !== -1;
            var dayButton = document.createElement('button');
            dayButton.type = 'button';
            dayButton.className = 'cart-calendar-day';
            dayButton.textContent = day.getDate();
            dayButton.dataset.date = key;
            if (day.getMonth() !== viewDate.getMonth()) dayButton.classList.add('is-outside');
            if (key === today) dayButton.classList.add('is-today');
            if (key === selectedDate) dayButton.classList.add('is-selected');
            if (blocked) {
              dayButton.disabled = true;
              dayButton.classList.add(key < minimumDate ? 'is-past' : 'is-unavailable');
            }
            dayButton.setAttribute('aria-label', day.getDate() + ' de ' + monthNames[day.getMonth()] + ' de ' + day.getFullYear() + (blocked ? ': indisponível' : ': disponível'));
            if (key === selectedDate) dayButton.setAttribute('aria-current', 'date');
            grid.appendChild(dayButton);
          }
        }

        function openCalendar() {
          closeCartCalendars(picker);
          var base = parseDateKey(selectedDate || minimumDate);
          viewDate = new Date(base.getFullYear(), base.getMonth(), 1);
          renderCalendar();
          calendar.hidden = false;
          trigger.setAttribute('aria-expanded', 'true');
        }

        trigger.addEventListener('click', function(event) {
          event.stopPropagation();
          if (calendar.hidden) {
            openCalendar();
          } else {
            calendar.hidden = true;
            trigger.setAttribute('aria-expanded', 'false');
          }
        });
        calendar.addEventListener('click', function(event) { event.stopPropagation(); });
        previous.addEventListener('click', function() {
          viewDate = new Date(viewDate.getFullYear(), viewDate.getMonth() - 1, 1);
          renderCalendar();
        });
        next.addEventListener('click', function() {
          viewDate = new Date(viewDate.getFullYear(), viewDate.getMonth() + 1, 1);
          renderCalendar();
        });
        grid.addEventListener('click', function(event) {
          var dayButton = event.target.closest('[data-date]');
          if (!dayButton || dayButton.disabled) return;
          selectedDate = dayButton.dataset.date;
          dateInput.value = selectedDate;
          label.textContent = formatDateKey(selectedDate);
          calendar.hidden = true;
          trigger.setAttribute('aria-expanded', 'false');
          if (typeof form.requestSubmit === 'function') form.requestSubmit();
          else form.submit();
        });
      });
      document.addEventListener('click', function(event) {
        closeCartCalendars(event.target.closest ? event.target.closest('[data-cart-date-picker]') : null);
      });
      document.addEventListener('keydown', function(event) {
        if (event.key === 'Escape') closeCartCalendars();
      });
      var toggle = document.querySelector('[data-salon-toggle]');
      var drawer = document.querySelector('[data-salon-drawer]');
      var salonDate = document.querySelector('#salon-date');
      var salonTime = document.querySelector('#salon-time');
      function updateSalonFields() {
        if (!toggle || !drawer) return;
        drawer.hidden = !toggle.checked;
        salonDate.required = toggle.checked;
        salonTime.required = toggle.checked;
      }
      if (toggle && drawer) {
        toggle.addEventListener('change', updateSalonFields);
        updateSalonFields();
      }
      var requestForm = document.querySelector('[data-submit-once]');
      var confirmOverlay = document.querySelector('[data-cart-confirm-overlay]');
      if (requestForm) requestForm.addEventListener('submit', function(event) {
        if (requestForm.dataset.submitted === 'true') { event.preventDefault(); return; }
        requestForm.dataset.submitted = 'true';
        var submitButton = requestForm.querySelector('[data-submit-once-button]');
        if (submitButton) submitButton.disabled = true;
        // A mensagem abre em outra aba; aqui perguntamos se o cliente conseguiu enviá-la.
        if (confirmOverlay) confirmOverlay.hidden = false;
      });
    })();
