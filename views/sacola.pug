extends layout

block content
  main.admin-page.cart-page
    p.admin-eyebrow MINHA CONTA
    h1.admin-title Minha sacola
    if rentalSuccess
      p.admin-success Solicitação registrada. Os itens ficarão indisponíveis até a devolução.
    if cartError
      p.admin-form-error= cartError
    if cart && cart.length
      .cart-list
        each item in cart
          .cart-item
            .cart-item-photo
              if item.imageUrl
                img(src=item.imageUrl alt='Foto de ' + item.name)
              else
                i.bi.bi-image(aria-hidden='true')
            .cart-item-info
              span= item.name
              small #{item.quantity} unidade(s)
            .cart-item-quantity
              form(method='post' action='/sacola/update')
                input(type='hidden' name='productId' value=item.productId)
                input(type='hidden' name='delta' value='-1')
                button.cart-quantity-button(type='submit' aria-label='Diminuir quantidade' title='Diminuir quantidade')
                  i.bi.bi-dash-lg(aria-hidden='true')
              strong= item.quantity
              form(method='post' action='/sacola/update')
                input(type='hidden' name='productId' value=item.productId)
                input(type='hidden' name='delta' value='1')
                button.cart-quantity-button(type='submit' aria-label='Aumentar quantidade' title='Aumentar quantidade')
                  i.bi.bi-plus-lg(aria-hidden='true')
            strong R$ #{(Number(item.price) * item.quantity).toFixed(2).replace('.', ',')}
      form(method='post' action='/sacola/confirm')
        button.admin-primary-button(type='submit')
          i.bi.bi-calendar-check(aria-hidden='true')
          | Fazer solicitação
      form(method='post' action='/sacola/clear')
        button.admin-danger-button(type='submit') Esvaziar sacola
    else
      .admin-empty
        i.bi.bi-bag
        p Sua sacola está vazia.
        a.admin-primary-button(href='/catalogo') Explorar catálogo
