extends layout

block content
  main.admin-page.cart-page
    a.admin-small-button.profile-back-link(href='javascript:history.back()' aria-label='Voltar' title='Voltar')
      i.bi.bi-arrow-left(aria-hidden='true')
    p.admin-eyebrow MINHA CONTA
    h1.admin-title Minha sacola
    if rentalSuccess
      p.admin-success Solicitação registrada. Os itens ficarão indisponíveis até a devolução.
    if cartError
      p.admin-form-error= cartError
    if cart && cart.length
      .cart-list
        each item in cart
          .cart-item
            a.cart-item-product-link(href='/produto/' + item.productId)
              .cart-item-photo
                if item.imageUrl
                  img(src=item.imageUrl alt='Foto de ' + item.name)
                else
                  i.bi.bi-image(aria-hidden='true')
            .cart-item-info
              a(href='/produto/' + item.productId)
                strong #{item.quantity}x #{item.name}
              label(for='date-' + item.productId) Data disponível
              form.cart-date-form(method='post' action='/sacola/data')
                input(type='hidden' name='productId' value=item.productId)
                select.cart-date-select(id='date-' + item.productId name='date' onchange="this.form.submit()")
                  each date in item.availableDates
                    option(value=date selected=date === item.requestDate)= date.split('-').reverse().join('/')
            strong R$ #{(Number(item.price) * item.quantity).toFixed(2).replace('.', ',')}
            .cart-quantity-actions
              form(method='post' action='/sacola/ajustar')
                input(type='hidden' name='productId' value=item.productId)
                input(type='hidden' name='delta' value='-1')
                button.cart-quantity-button(type='submit' aria-label='Remover uma unidade' title='Remover uma unidade')
                  i.bi.bi-dash-lg(aria-hidden='true')
              span= item.quantity
              form(method='post' action='/sacola/ajustar')
                input(type='hidden' name='productId' value=item.productId)
                input(type='hidden' name='delta' value='1')
                button.cart-quantity-button(type='submit' aria-label='Adicionar uma unidade' title='Adicionar uma unidade')
                  i.bi.bi-plus-lg(aria-hidden='true')
      form(method='post' action='/sacola/confirmar')
        h2 Dados da entrega
        .auth-field
          label(for='saved-delivery-address') Usar endereço salvo
          select#saved-delivery-address
            option(value='') Digitar outro endereço
            if deliveryProfile && deliveryProfile.address
              option(value=JSON.stringify({ address: deliveryProfile.address, city: deliveryProfile.city, state: deliveryProfile.state, cep: deliveryProfile.cep }) selected) Endereço principal
            each savedAddress, index in (deliveryProfile && deliveryProfile.addresses || [])
              option(value=JSON.stringify({ address: savedAddress.address, city: savedAddress.city, state: savedAddress.state, cep: savedAddress.cep }) selected=(!deliveryProfile.address && index === 0 ? true : undefined))= savedAddress.label || ('Endereço salvo ' + (index + 1))
        .register-location-fields
          .auth-field
            label(for='delivery-address') Endereço
            input#delivery-address(type='text' name='deliveryAddress' autocomplete='street-address' required value=(deliveryProfile && deliveryProfile.address) || '')
          .auth-field
            label(for='delivery-city') Cidade
            input#delivery-city(type='text' name='deliveryCity' autocomplete='address-level2' required value=(deliveryProfile && deliveryProfile.city) || '')
          .auth-field
            label(for='delivery-state') UF
            input#delivery-state(type='text' name='deliveryState' maxlength='2' autocomplete='address-level1' required value=(deliveryProfile && deliveryProfile.state) || '')
          .auth-field
            label(for='delivery-cep') CEP
            input#delivery-cep(type='text' name='deliveryCep' autocomplete='postal-code' required value=(deliveryProfile && deliveryProfile.cep) || '')
          .auth-field
            label(for='delivery-date') Data prevista da entrega
            input#delivery-date(type='date' name='deliveryDate' required)
          .auth-field
            label(for='delivery-time') Horário previsto da entrega
            input#delivery-time(type='time' name='deliveryTime' required)
        label.salon-rental-check
          input(type='checkbox' name='salonRental' data-salon-toggle)
          | Desejo alugar também o horário do salão
        .salon-rental-drawer(data-salon-drawer hidden)
          label(for='salon-date') Dia do salão
          input#salon-date(type='date' name='salonDate')
          label(for='salon-time') Horário do salão
          input#salon-time(type='time' name='salonTime')
        button.admin-primary-button(type='submit')
          i.bi.bi-calendar-check(aria-hidden='true')
          | Fazer solicitação
      form(method='post' action='/sacola/limpar')
        button.admin-danger-button(type='submit') Esvaziar sacola
    else
      .admin-empty
        i.bi.bi-bag
        p Sua sacola está vazia.
        a.admin-primary-button(href='/catalogo') Explorar catálogo
  script.
    (function() {
    var savedAddress = document.querySelector('#saved-delivery-address');
    if (savedAddress) savedAddress.addEventListener('change', function() {
      if (!savedAddress.value) {
        document.querySelector('#delivery-address').value = '';
        document.querySelector('#delivery-city').value = '';
        document.querySelector('#delivery-state').value = '';
        document.querySelector('#delivery-cep').value = '';
        return;
      }
      try {
        var address = JSON.parse(savedAddress.value);
        document.querySelector('#delivery-address').value = address.address || '';
        document.querySelector('#delivery-city').value = address.city || '';
        document.querySelector('#delivery-state').value = address.state || '';
        document.querySelector('#delivery-cep').value = address.cep || '';
      } catch (error) {}
    });
    if (savedAddress && savedAddress.value) savedAddress.dispatchEvent(new Event('change'));
      var toggle = document.querySelector('[data-salon-toggle]');
      var drawer = document.querySelector('[data-salon-drawer]');
      if (toggle && drawer) toggle.addEventListener('change', function() { drawer.hidden = !toggle.checked; });
    })();
