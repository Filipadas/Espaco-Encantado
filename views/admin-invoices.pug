extends layout

block content
  main.admin-page
    a.admin-back-link(href='/admin')
      i.bi.bi-arrow-left
      | Painel administrativo
    p.admin-eyebrow FINANCEIRO
    h1.admin-title Comprovantes de locação
    .admin-table-wrap
      table.admin-table
        thead
          tr
            th Cliente
            th Datas
            th Status
            th Comprovante
        tbody
          each rental in rentals
            tr
              td(data-label='Cliente')= rental.user ? rental.user.name : 'Cliente'
              td(data-label='Datas')= (rental.dates || []).join(' | ')
              td(data-label='Status')= rental.status === 'active' ? 'Ativa' : rental.status === 'returned' ? 'Devolvida' : rental.status === 'cancelled' ? 'Cancelada' : rental.status
              td(data-label='Comprovante')
                if rental.invoiceGenerated
                  a.admin-small-button(href='/admin/invoices/' + rental._id + '/view') Visualizar comprovante
                else
                  form(method='post' action='/admin/invoices/' + rental._id + '/create')
                    button.admin-small-button(type='submit') Criar comprovante
          else
            tr
              td(colspan='4') Nenhuma solicitação registrada.
