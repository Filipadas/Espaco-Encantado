extends layout

block content
  main.confirmation-page
    .confirmation-card
      img.auth-logo(src='/images/logo_ee.png' alt='Espaço Encantado')
      h1.admin-title Excluir conta?
      p.admin-subtitle Esta ação é permanente. Digite sua senha para confirmar.
      if formError
        p.admin-form-error= formError
      form.admin-form(method='post' action='/users/delete')
        label(for='delete-password') Senha da conta
        input#delete-password(type='password' name='password' required autocomplete='current-password')
        .profile-actions
          a.admin-small-button.confirm-cancel-button(href='/perfil') Cancelar
          button.admin-danger-button(type='submit') Excluir conta