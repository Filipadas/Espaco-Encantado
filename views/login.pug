doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title Entrar | Espaço Encantado
    link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css')
    link(rel='stylesheet' href='/stylesheets/style.css?v=20260723')
  body.auth-page
    main.login-screen
      section.login-welcome
        .login-topbar
          .auth-brand
            img.auth-logo(src='/images/logo_ee.png' alt='Espaço Encantado')
          a.auth-home-button(href='/' aria-label='Ir para a página inicial' title='Página inicial')
            i.bi.bi-house-fill(aria-hidden='true')
          .login-welcome-copy
            span.auth-kicker BEM-VINDO DE VOLTA
            h1= settings.loginWelcome || 'Entre para continuar criando momentos inesquecíveis.'
            p Acesse sua conta para acompanhar seus agendamentos e continuar planejando uma festa cheia de encanto.
      button.theme-toggle.auth-theme-toggle(type='button' data-auth-theme-toggle aria-label='Alternar modo escuro' title='Alternar modo escuro')
        i.bi.bi-moon-stars-fill(aria-hidden='true')
      section.login-panel(aria-labelledby='login-title')
        .auth-form-shell
          h1#login-title.auth-title Entrar
          p.auth-subtitle= settings.loginSubtitle || 'Acesse sua conta Espaço Encantado.'
          .auth-divider
            span ou continue com seu e-mail
          if loginError
            p.auth-form-error= loginError
          form.auth-form(method='post' action='/login')
            input(type='hidden' name='returnTo' value=returnTo || '/')
            label(for='login-email') E-mail
            input#login-email(type='email' name='email' placeholder='seu@email.com' autocomplete='email' required)
            label(for='login-password') Senha
            input#login-password(type='password' name='password' placeholder='Digite sua senha' autocomplete='current-password' required)
            .auth-form-row
              label.auth-check
                input(type='checkbox' name='remember')
                | Lembrar de mim
              a.auth-inline-link(href='#') Esqueci minha senha
            button.auth-submit(type='submit') Entrar
          .auth-divider
            span ou
          .social-login-group
            button.auth-social-button(type='button')
              i.bi.bi-google(aria-hidden='true')
              | Entrar com Google
            button.auth-social-button(type='button')
              i.bi.bi-apple(aria-hidden='true')
              | Entrar com Apple
          p.auth-switch Ainda não tem uma conta? 
            a.auth-link(href='/cadastro') Criar cadastro
      script.
        (function() {
          var toggle = document.querySelector('[data-auth-theme-toggle]');
          var dark = window.localStorage.getItem('espaco-encantado-theme') === 'dark';
          document.body.classList.toggle('dark-mode', dark);
          if (toggle) toggle.addEventListener('click', function() {
            dark = !dark;
            document.body.classList.toggle('dark-mode', dark);
            window.localStorage.setItem('espaco-encantado-theme', dark ? 'dark' : 'light');
          });
        })();
