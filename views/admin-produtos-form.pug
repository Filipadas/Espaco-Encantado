extends layout

block content
  - var catalogSpecifications = Array.isArray(specificationCatalog) ? specificationCatalog : []
  - var categorySubcategories = subcategoryCatalog || {}
  - var selectedProductSubcategories = Array.isArray(product.subcategories) ? product.subcategories : []
  main.admin-page
    a.admin-back-link(href='/admin/produtos')
      i.bi.bi-arrow-left
      | Gerenciamento de produtos
    .admin-form-panel
      p.admin-eyebrow= isEditing ? 'EDITAR ITEM' : 'NOVO ITEM'
      h1.admin-title= isEditing ? 'Editar produto' : 'Cadastrar produto'
      if formError
        p.admin-form-error= formError
      form.admin-form(method='post' enctype='multipart/form-data' action=isEditing ? '/admin/produtos/' + product._id : '/admin/produtos')
        input(type='hidden' name='carouselOrderSubmitted' value='1')
        label(for='product-images') Foto principal e fotos do carrossel
        input#product-images(type='file' name='images' accept='image/*' multiple)
        p.admin-form-hint Confira a prévia do carrossel, remova fotos ou use as setas para definir a ordem. A primeira será a foto principal.
        label(for='product-name') Nome do produto
        input#product-name(type='text' name='name' value=product.name required)
        label(for='product-category') Categoria
        select#product-category(name='category' required)
          option(value='brinquedos' selected=product.category === 'brinquedos') Brinquedos
          option(value='decoracoes' selected=product.category === 'decoracoes') Decorações
          option(value='kit-montagem' selected=product.category === 'kit-montagem') Kit de montagem
          option(value='festa-infantil' selected=product.category === 'festa-infantil') Festa infantil
        fieldset.admin-subcategories(data-subcategories-section data-initial-category=product.category || '')
          legend Subcategorias
          p.admin-form-hint Selecione uma ou mais subcategorias. Você também pode criar uma nova.
          input(type='hidden' name='subcategoryPayload' value='[]' data-subcategory-payload)
          details.admin-subcategory-dropdown
            summary(data-subcategory-summary) Escolher subcategorias
            .admin-subcategory-menu
              each categoryNames, categoryName in categorySubcategories
                .admin-subcategory-group(data-subcategory-category=categoryName)
                  each subcategoryName in categoryNames
                    .admin-subcategory-entry(data-subcategory-entry)
                      label.admin-subcategory-option
                        input(type='checkbox' data-subcategory-option value=subcategoryName checked=product.category === categoryName && selectedProductSubcategories.indexOf(subcategoryName) !== -1)
                        span= subcategoryName
                      button.admin-icon-button.admin-icon-button-danger.admin-subcategory-delete(type='button' data-delete-subcategory data-subcategory-category=categoryName data-subcategory-name=subcategoryName aria-label='Excluir subcategoria ' + subcategoryName title='Excluir subcategoria')
                        i.bi.bi-trash3-fill(aria-hidden='true')
          .admin-subcategory-create
            input(type='text' data-new-subcategory placeholder='Ex.: Brinquedos educativos')
            button.admin-small-button(type='button' data-add-subcategory) Criar subcategoria
        .admin-custom-text-option(data-custom-text-section hidden)
          label.admin-custom-text-check
            input(type='checkbox' name='allowCustomText' checked=product.allowCustomText data-custom-text-toggle)
            span Caixa para inserir texto
            small.admin-custom-text-hint O cliente escreve o texto ao adicionar à sacola — desmarque para usar um texto pré-personalizado.
          .admin-custom-text-predefined(data-predefined-text-section hidden=product.allowCustomText)
            label(for='product-predefined-text') Texto pré-personalizado
            input#product-predefined-text(type='text' name='predefinedCustomText' maxlength='200' value=product.predefinedCustomText placeholder='Ex.: Feliz aniversário, Sofia!')
        label(for='product-price') Preço
        input#product-price(type='number' name='price' min='0' step='0.01' value=product.price required)
        label(for='product-stock') Estoque total
        input#product-stock(type='number' name='stockTotal' min='0' step='1' value=product.stockTotal || 0 required)
        label(for='product-description') Descrição
        textarea#product-description(name='description' rows='4')= product.description
        label(for='product-image') Foto principal por URL (opcional)
        input#product-image(type='url' name='imageUrl' value=product.imageUrl placeholder='https://exemplo.com/foto.jpg')
        p.admin-form-hint O carrossel do produto usa as fotos organizadas abaixo. A foto por URL é usada quando não houver fotos no carrossel.
        .admin-image-order(data-image-order)
          if product.imageUrls && product.imageUrls.length
            each image in product.imageUrls
              .admin-image-order-row
                input(type='hidden' name='carouselImageOrder' value='existing:' + image)
                img(src=image alt='Foto cadastrada')
                span= image
                button.admin-icon-button(type='button' data-move-image='up' aria-label='Mover foto para cima' title='Mover para cima')
                  i.bi.bi-arrow-up(aria-hidden='true')
                button.admin-icon-button(type='button' data-move-image='down' aria-label='Mover foto para baixo' title='Mover para baixo')
                  i.bi.bi-arrow-down(aria-hidden='true')
                button.admin-icon-button.admin-icon-button-danger(type='button' data-remove-image aria-label='Remover foto' title='Remover foto')
                  i.bi.bi-trash3-fill(aria-hidden='true')
          else if product.imageUrl
            .admin-image-order-row
              input(type='hidden' name='carouselImageOrder' value='existing:' + product.imageUrl)
              img(src=product.imageUrl alt='Foto cadastrada')
              span= product.imageUrl
              button.admin-icon-button(type='button' data-move-image='up' aria-label='Mover foto para cima' title='Mover para cima')
                i.bi.bi-arrow-up(aria-hidden='true')
              button.admin-icon-button(type='button' data-move-image='down' aria-label='Mover foto para baixo' title='Mover para baixo')
                i.bi.bi-arrow-down(aria-hidden='true')
              button.admin-icon-button.admin-icon-button-danger(type='button' data-remove-image aria-label='Remover foto' title='Remover foto')
                i.bi.bi-trash3-fill(aria-hidden='true')
        .admin-carousel-preview(aria-live='polite')
          strong Prévia do carrossel
          .admin-carousel-preview-stage(data-carousel-stage)
            if product.imageUrls && product.imageUrls.length
              img(src=product.imageUrls[0] alt='Prévia do carrossel')
            else if product.imageUrl
              img(src=product.imageUrl alt='Prévia do carrossel')
            else
              span Nenhuma imagem selecionada
          .admin-carousel-preview-controls
            button.admin-icon-button(type='button' data-preview-prev aria-label='Foto anterior' title='Foto anterior')
              i.bi.bi-chevron-left(aria-hidden='true')
            span(data-preview-position) 0 / 0
            button.admin-icon-button(type='button' data-preview-next aria-label='Próxima foto' title='Próxima foto')
              i.bi.bi-chevron-right(aria-hidden='true')
        if availableProducts && availableProducts.length
          fieldset.admin-components(data-components-section)
            legend Componentes do kit ou festa
            p.admin-form-hint Selecione produtos já cadastrados. Você pode adicionar quantos componentes forem necessários.
            .admin-component-list(data-component-list)
              if product.components && product.components.length
                each component in product.components
                  .admin-component-row
                    select.admin-component-category(name='componentCategory' data-component-category)
                      option(value='brinquedos' selected=component.product.category === 'brinquedos') Brinquedos
                      option(value='decoracoes' selected=component.product.category === 'decoracoes') Decorações
                    select.admin-component-select(name='componentProduct')
                      option(value='') Selecione um produto
                      each availableProduct in availableProducts
                        option(value=availableProduct._id data-category=availableProduct.category selected=String(availableProduct._id) === String(component.product._id || component.product))= availableProduct.name
                    input(type='number' name='componentQuantity' min='1' step='1' value=component.quantity required)
                    button.admin-icon-button.admin-icon-button-danger(type='button' data-remove-component aria-label='Remover componente' title='Remover componente')
                      i.bi.bi-trash3-fill(aria-hidden='true')
              .admin-component-row(data-component-template)
                select.admin-component-category(name='componentCategory' data-component-category)
                  option(value='brinquedos') Brinquedos
                  option(value='decoracoes') Decorações
                select.admin-component-select(name='componentProduct')
                  option(value='') Selecione um produto
                  each availableProduct in availableProducts
                    option(value=availableProduct._id data-category=availableProduct.category)= availableProduct.name
                input(type='number' name='componentQuantity' min='1' step='1' value='1')
                button.admin-icon-button.admin-icon-button-danger(type='button' data-remove-component aria-label='Remover componente' title='Remover componente')
                  i.bi.bi-trash3-fill(aria-hidden='true')
            button.admin-small-button(type='button' data-add-component)
              i.bi.bi-plus-lg(aria-hidden='true')
              | Adicionar componente
        fieldset.admin-specifications
          legend Especificações
          p.admin-form-hint Marque uma especificação e escolha os valores que se aplicam a este produto. Novas opções ficam disponíveis para os próximos cadastros.
          input(type='hidden' name='specificationPayload' value='[]' data-specification-payload)
          .admin-specification-list(data-specification-list)
            each specification in catalogSpecifications
              - var selectedSpecificationValues = Array.isArray(specification.selectedValues) ? specification.selectedValues : []
              - var availableSpecificationValues = Array.isArray(specification.values) ? specification.values : []
              - var specificationSelected = selectedSpecificationValues.length > 0
              .admin-specification-card(data-specification-card)
                .admin-specification-top
                  label.admin-specification-heading
                    input(type='checkbox' data-specification-toggle checked=specificationSelected)
                    span= specification.name
                  if specification.isSaved
                    button.admin-icon-button.admin-icon-button-danger(type='button' data-delete-specification data-specification-name=specification.name aria-label='Excluir especificação ' + specification.name title='Excluir especificação')
                      i.bi.bi-trash3-fill(aria-hidden='true')
                .admin-specification-options(data-specification-options hidden=!specificationSelected)
                  .admin-specification-value-list(data-specification-value-list)
                    each value in availableSpecificationValues
                      label.admin-specification-option
                        input(type='checkbox' data-specification-value value=value checked=selectedSpecificationValues.indexOf(value) !== -1)
                        span= value
                  .admin-specification-custom
                    input(type='text' data-custom-values placeholder='Adicionar opção personalizada')
                    button.admin-small-button(type='button' data-add-specification-value) Adicionar opção
          .admin-specification-builder
            strong Cadastrar nova especificação
            .admin-specification-builder-fields
              input(type='text' data-new-specification-name placeholder='Ex.: Material')
              input(type='text' data-new-specification-values placeholder='Opções separadas por vírgulas')
              button.admin-small-button(type='button' data-create-specification)
                i.bi.bi-plus-lg(aria-hidden='true')
                | Adicionar
          .admin-specification-selection(aria-live='polite')
            strong Especificações aplicadas ao produto
            .admin-specification-summary(data-specification-summary)
              span Nenhuma especificação selecionada
        button.admin-primary-button(type='submit')
          i.bi.bi-check-lg
          = isEditing ? ' Salvar alterações' : ' Salvar produto'

  script.
    (function() {
      var list = document.querySelector('[data-component-list]');
      var template = document.querySelector('[data-component-template]');
      var addButton = document.querySelector('[data-add-component]');
      if (list && template && addButton) {
        template.removeAttribute('data-component-template');
        addButton.addEventListener('click', function() {
          var row = template.cloneNode(true);
          row.querySelector('select').value = '';
          row.querySelector('input').value = '1';
          list.appendChild(row);
        });
        list.addEventListener('click', function(event) {
          var removeButton = event.target.closest('[data-remove-component]');
          if (removeButton) removeButton.closest('.admin-component-row').remove();
        });
        var categorySelect = document.querySelector('#product-category');
        var componentSection = document.querySelector('[data-components-section]');
        function updateComponents() {
          if (!componentSection) return;
          var visible = categorySelect.value === 'kit-montagem' || categorySelect.value === 'festa-infantil';
          componentSection.hidden = !visible;
          componentSection.querySelectorAll('[data-component-category]').forEach(function(category) {
            var productSelect = category.closest('.admin-component-row').querySelector('.admin-component-select');
            productSelect.querySelectorAll('option[data-category]').forEach(function(option) {
              option.hidden = option.dataset.category !== category.value;
            });
          });
        }
        categorySelect.addEventListener('change', updateComponents);
        list.addEventListener('change', function(event) {
          if (event.target.matches('[data-component-category]')) updateComponents();
        });
        updateComponents();
      }
      var specificationList = document.querySelector('[data-specification-list]');
      var specificationPayload = document.querySelector('[data-specification-payload]');
      var specificationSummary = document.querySelector('[data-specification-summary]');
      var newSpecificationName = document.querySelector('[data-new-specification-name]');
      var newSpecificationValues = document.querySelector('[data-new-specification-values]');
      var createSpecificationButton = document.querySelector('[data-create-specification]');
      function splitSpecificationValues(value) {
        return value.split(',').map(function(item) { return item.trim(); }).filter(Boolean);
      }
      function parseAdminJsonResponse(response) {
        return response.text().then(function(text) {
          var result;
          try { result = JSON.parse(text); }
          catch (error) { result = { ok: false, message: 'O servidor não reconheceu esta operação (HTTP ' + response.status + '). Reinicie o servidor e tente novamente.' }; }
          return { ok: response.ok, result: result };
        });
      }
      function getCardSpecification(card) {
        var toggle = card.querySelector('[data-specification-toggle]');
        if (!toggle.checked) return null;
        var name = card.querySelector('.admin-specification-heading span').textContent.trim();
        var selectedValues = Array.from(card.querySelectorAll('[data-specification-value]:checked')).map(function(input) { return input.value; });
        var availableValues = Array.from(card.querySelectorAll('[data-specification-value]')).map(function(input) { return input.value; });
        var customInput = card.querySelector('[data-custom-values]');
        if (customInput) {
          var customValues = splitSpecificationValues(customInput.value);
          selectedValues = selectedValues.concat(customValues);
          availableValues = availableValues.concat(customValues);
        }
        selectedValues = selectedValues.filter(function(value, index, values) {
          return values.findIndex(function(other) { return other.toLocaleLowerCase() === value.toLocaleLowerCase(); }) === index;
        });
        availableValues = availableValues.concat(selectedValues).filter(function(value, index, values) {
          return values.findIndex(function(other) { return other.toLocaleLowerCase() === value.toLocaleLowerCase(); }) === index;
        });
        return selectedValues.length ? { name: name, values: selectedValues, availableValues: availableValues } : null;
      }
      function updateSpecificationSummary() {
        if (!specificationList || !specificationSummary) return;
        var selected = Array.from(specificationList.querySelectorAll('[data-specification-card]')).map(getCardSpecification).filter(Boolean);
        specificationSummary.innerHTML = '';
        if (!selected.length) {
          var empty = document.createElement('span');
          empty.textContent = 'Nenhuma especificação selecionada';
          specificationSummary.appendChild(empty);
          return;
        }
        selected.forEach(function(specification) {
          var item = document.createElement('span');
          item.className = 'admin-specification-chip';
          item.textContent = specification.name + ': ' + specification.values.join(', ');
          specificationSummary.appendChild(item);
        });
      }
      function createSpecificationCard(name, values) {
        var card = document.createElement('div');
        card.className = 'admin-specification-card';
        card.setAttribute('data-specification-card', '');
        var top = document.createElement('div');
        top.className = 'admin-specification-top';
        var heading = document.createElement('label');
        heading.className = 'admin-specification-heading';
        var toggle = document.createElement('input');
        toggle.type = 'checkbox';
        toggle.checked = true;
        toggle.value = name;
        toggle.setAttribute('data-specification-toggle', '');
        var title = document.createElement('span');
        title.textContent = name;
        heading.append(toggle, title);
        var deleteButton = document.createElement('button');
        deleteButton.type = 'button';
        deleteButton.className = 'admin-icon-button admin-icon-button-danger';
        deleteButton.setAttribute('data-delete-specification', '');
        deleteButton.dataset.specificationName = name;
        deleteButton.setAttribute('aria-label', 'Excluir especificação ' + name);
        deleteButton.title = 'Excluir especificação';
        deleteButton.innerHTML = '<i class="bi bi-trash3-fill" aria-hidden="true"></i>';
        top.append(heading, deleteButton);
        var options = document.createElement('div');
        options.className = 'admin-specification-options';
        options.setAttribute('data-specification-options', '');
        var valueList = document.createElement('div');
        valueList.className = 'admin-specification-value-list';
        valueList.setAttribute('data-specification-value-list', '');
        values.forEach(function(value) {
          var optionLabel = document.createElement('label');
          optionLabel.className = 'admin-specification-option';
          var option = document.createElement('input');
          option.type = 'checkbox';
          option.checked = true;
          option.value = value;
          option.setAttribute('data-specification-value', '');
          var optionText = document.createElement('span');
          optionText.textContent = value;
          optionLabel.append(option, optionText);
          valueList.appendChild(optionLabel);
        });
        var custom = document.createElement('div');
        custom.className = 'admin-specification-custom';
        var customInput = document.createElement('input');
        customInput.type = 'text';
        customInput.placeholder = 'Adicionar opção personalizada';
        customInput.setAttribute('data-custom-values', '');
        var addValue = document.createElement('button');
        addValue.type = 'button';
        addValue.className = 'admin-small-button';
        addValue.textContent = 'Adicionar opção';
        addValue.setAttribute('data-add-specification-value', '');
        custom.append(customInput, addValue);
        options.append(valueList, custom);
        card.append(top, options);
        specificationList.appendChild(card);
        updateSpecificationSummary();
      }
      if (specificationList) {
        specificationList.addEventListener('change', function(event) {
          if (event.target.matches('[data-specification-toggle]')) {
            event.target.closest('[data-specification-card]').querySelector('[data-specification-options]').hidden = !event.target.checked;
          }
          updateSpecificationSummary();
        });
        specificationList.addEventListener('input', function(event) {
          if (event.target.matches('[data-custom-values]')) updateSpecificationSummary();
        });
        specificationList.addEventListener('click', function(event) {
          var deleteSpecification = event.target.closest('[data-delete-specification]');
          if (deleteSpecification) {
            var specificationName = deleteSpecification.dataset.specificationName;
            if (!window.confirm('Tem certeza de que deseja excluir a especificação "' + specificationName + '"? Ela deixará de aparecer nos próximos cadastros e edições.')) return;
            deleteSpecification.disabled = true;
            fetch('/admin/especificacoes/excluir', {
              method: 'POST',
              headers: { 'Content-Type': 'application/x-www-form-urlencoded', Accept: 'application/json' },
              body: new URLSearchParams({ name: specificationName })
            }).then(parseAdminJsonResponse)
              .then(function(data) {
                if (!data.ok) throw new Error(data.result.message || 'Não foi possível excluir a especificação.');
                deleteSpecification.closest('[data-specification-card]').remove();
                updateSpecificationSummary();
              })
              .catch(function(error) {
                deleteSpecification.disabled = false;
                window.alert(error.message || 'Não foi possível excluir a especificação.');
              });
            return;
          }
          var addValue = event.target.closest('[data-add-specification-value]');
          if (!addValue) return;
          var card = addValue.closest('[data-specification-card]');
          var input = card.querySelector('[data-custom-values]');
          var values = splitSpecificationValues(input.value);
          var valueList = card.querySelector('[data-specification-value-list]');
          var newValues = values.filter(function(value) {
            return !Array.from(valueList.querySelectorAll('[data-specification-value]')).some(function(option) { return option.value.toLocaleLowerCase() === value.toLocaleLowerCase(); });
          });
          if (!newValues.length) { input.value = ''; return; }
          var specificationName = card.querySelector('.admin-specification-heading span').textContent.trim();
          addValue.disabled = true;
          fetch('/admin/especificacoes/valores', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', Accept: 'application/json' },
            body: new URLSearchParams({ name: specificationName, values: JSON.stringify(newValues) })
          }).then(parseAdminJsonResponse)
            .then(function(data) {
              if (!data.ok) throw new Error(data.result.message || 'Não foi possível salvar as opções.');
              newValues.forEach(function(value) {
                var label = document.createElement('label');
                label.className = 'admin-specification-option';
                var checkbox = document.createElement('input');
                checkbox.type = 'checkbox';
                checkbox.checked = true;
                checkbox.value = value;
                checkbox.setAttribute('data-specification-value', '');
                var text = document.createElement('span');
                text.textContent = value;
                label.append(checkbox, text);
                valueList.appendChild(label);
              });
              input.value = '';
              updateSpecificationSummary();
            })
            .catch(function(error) { window.alert(error.message || 'Não foi possível salvar as opções.'); })
            .finally(function() { addValue.disabled = false; });
        });
        updateSpecificationSummary();
      }
      if (createSpecificationButton) createSpecificationButton.addEventListener('click', function() {
        var name = newSpecificationName.value.trim();
        var values = splitSpecificationValues(newSpecificationValues.value);
        if (!name || !values.length) {
          newSpecificationName.focus();
          return;
        }
        var duplicate = Array.from(specificationList.querySelectorAll('[data-specification-toggle]')).some(function(toggle) {
          return toggle.closest('[data-specification-card]').querySelector('.admin-specification-heading span').textContent.trim().toLocaleLowerCase() === name.toLocaleLowerCase();
        });
        if (duplicate) {
          newSpecificationName.focus();
          return;
        }
        createSpecificationButton.disabled = true;
        fetch('/admin/especificacoes', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded', Accept: 'application/json' },
          body: new URLSearchParams({ name: name, values: JSON.stringify(values) })
        }).then(parseAdminJsonResponse)
          .then(function(data) {
            if (!data.ok) throw new Error(data.result.message || 'Não foi possível salvar a especificação.');
            createSpecificationCard(name, values);
            newSpecificationName.value = '';
            newSpecificationValues.value = '';
          })
          .catch(function(error) { window.alert(error.message || 'Não foi possível salvar a especificação.'); })
          .finally(function() { createSpecificationButton.disabled = false; });
      });
      var subcategorySection = document.querySelector('[data-subcategories-section]');
      var subcategoryPayload = document.querySelector('[data-subcategory-payload]');
      var subcategorySummary = document.querySelector('[data-subcategory-summary]');
      var newSubcategoryInput = document.querySelector('[data-new-subcategory]');
      var addSubcategoryButton = document.querySelector('[data-add-subcategory]');
      var productCategorySelect = document.querySelector('#product-category');
      var customTextSection = document.querySelector('[data-custom-text-section]');
      var predefinedTextSection = document.querySelector('[data-predefined-text-section]');
      var customTextToggle = customTextSection ? customTextSection.querySelector('[data-custom-text-toggle]') : null;
      var predefinedTextInput = customTextSection ? customTextSection.querySelector('input[name="predefinedCustomText"]') : null;
      function isCustomTextSubcategory(name) {
        var normalized = String(name || '').toLowerCase();
        if (normalized.normalize) normalized = normalized.normalize('NFD').replace(/[\u0300-\u036f]/g, '');
        // "balões" normalizado é "baloes" (não "balao"), por isso a checagem cobre as duas formas.
        var isBalloon = normalized.indexOf('balao') !== -1 || normalized.indexOf('baloe') !== -1;
        return isBalloon && normalized.indexOf('personaliza') !== -1;
      }
      function updateCustomTextPredefined() {
        if (predefinedTextSection) predefinedTextSection.hidden = !!(customTextToggle && customTextToggle.checked);
      }
      var customTextConfiguredAtLoad = !!(customTextToggle && customTextToggle.checked) || !!(predefinedTextInput && predefinedTextInput.value.trim());
      function updateCustomTextOption() {
        if (!customTextSection || !subcategorySection) return;
        var matched = Array.from(subcategorySection.querySelectorAll('[data-subcategory-option]:checked')).some(function(option) { return isCustomTextSubcategory(option.value); });
        var visible = matched || customTextConfiguredAtLoad;
        customTextSection.hidden = !visible;
        if (!visible) {
          if (customTextToggle) customTextToggle.checked = false;
          if (predefinedTextInput) predefinedTextInput.value = '';
        }
        updateCustomTextPredefined();
      }
      if (customTextToggle) customTextToggle.addEventListener('change', updateCustomTextPredefined);
      function updateSubcategorySummary() {
        updateCustomTextOption();
        if (!subcategorySection || !subcategorySummary) return;
        var selectedNames = Array.from(subcategorySection.querySelectorAll('[data-subcategory-option]:checked')).map(function(option) { return option.value; });
        subcategorySummary.textContent = selectedNames.length ? selectedNames.join(', ') : 'Escolher subcategorias';
      }
      if (subcategorySection && productCategorySelect) {
        var previousSubcategoryCategory = subcategorySection.dataset.initialCategory || productCategorySelect.value;
        function updateSubcategoryGroups(clearPrevious) {
          var category = productCategorySelect.value;
          if (clearPrevious && previousSubcategoryCategory !== category) {
            subcategorySection.querySelectorAll('[data-subcategory-option]').forEach(function(option) { option.checked = false; });
          }
          subcategorySection.querySelectorAll('[data-subcategory-category]').forEach(function(group) {
            group.hidden = group.dataset.subcategoryCategory !== category;
          });
          previousSubcategoryCategory = category;
          updateSubcategorySummary();
        }
        productCategorySelect.addEventListener('change', function() { updateSubcategoryGroups(true); });
        subcategorySection.addEventListener('change', function(event) {
          if (event.target.matches('[data-subcategory-option]')) updateSubcategorySummary();
        });
        subcategorySection.addEventListener('click', function(event) {
          var deleteButton = event.target.closest('[data-delete-subcategory]');
          if (!deleteButton) return;
          var category = deleteButton.dataset.subcategoryCategory;
          var name = deleteButton.dataset.subcategoryName;
          if (!window.confirm('Tem certeza de que deseja excluir a subcategoria "' + name + '"? Ela será removida dos produtos que a utilizam.')) return;
          deleteButton.disabled = true;
          fetch('/admin/subcategorias/excluir', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', Accept: 'application/json' },
            body: new URLSearchParams({ category: category, name: name })
          }).then(parseAdminJsonResponse).then(function(data) {
            if (!data.ok) throw new Error(data.result.message || 'Não foi possível excluir a subcategoria.');
            deleteButton.closest('[data-subcategory-entry]').remove();
            updateSubcategorySummary();
          }).catch(function(error) {
            deleteButton.disabled = false;
            window.alert(error.message || 'Não foi possível excluir a subcategoria.');
          });
        });
        updateSubcategoryGroups(false);
        if (addSubcategoryButton) addSubcategoryButton.addEventListener('click', function() {
          var name = newSubcategoryInput.value.trim();
          if (!name) { newSubcategoryInput.focus(); return; }
          var category = productCategorySelect.value;
          var group = Array.from(subcategorySection.querySelectorAll('[data-subcategory-category]')).find(function(item) { return item.dataset.subcategoryCategory === category; });
          var duplicate = group && Array.from(group.querySelectorAll('[data-subcategory-option]')).some(function(option) { return option.value.toLocaleLowerCase() === name.toLocaleLowerCase(); });
          if (duplicate) { newSubcategoryInput.focus(); return; }
          addSubcategoryButton.disabled = true;
          fetch('/admin/subcategorias', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', Accept: 'application/json' },
            body: new URLSearchParams({ category: category, name: name })
          }).then(parseAdminJsonResponse).then(function(data) {
            if (!data.ok) throw new Error(data.result.message || 'Não foi possível salvar a subcategoria.');
            if (!group) {
              group = document.createElement('div');
              group.className = 'admin-subcategory-group';
              group.setAttribute('data-subcategory-category', category);
              subcategorySection.querySelector('.admin-subcategory-menu').appendChild(group);
            }
            var entry = document.createElement('div');
            entry.className = 'admin-subcategory-entry';
            entry.setAttribute('data-subcategory-entry', '');
            var label = document.createElement('label');
            label.className = 'admin-subcategory-option';
            var checkbox = document.createElement('input');
            checkbox.type = 'checkbox';
            checkbox.checked = true;
            checkbox.value = name;
            checkbox.setAttribute('data-subcategory-option', '');
            var text = document.createElement('span');
            text.textContent = name;
            label.append(checkbox, text);
            var deleteButton = document.createElement('button');
            deleteButton.type = 'button';
            deleteButton.className = 'admin-icon-button admin-icon-button-danger admin-subcategory-delete';
            deleteButton.setAttribute('data-delete-subcategory', '');
            deleteButton.dataset.subcategoryCategory = category;
            deleteButton.dataset.subcategoryName = name;
            deleteButton.setAttribute('aria-label', 'Excluir subcategoria ' + name);
            deleteButton.title = 'Excluir subcategoria';
            deleteButton.innerHTML = '<i class="bi bi-trash3-fill" aria-hidden="true"></i>';
            entry.append(label, deleteButton);
            group.appendChild(entry);
            updateSubcategoryGroups(false);
            newSubcategoryInput.value = '';
          }).catch(function(error) {
            window.alert(error.message || 'Não foi possível salvar a subcategoria.');
          }).finally(function() { addSubcategoryButton.disabled = false; });
        });
      }
      var productForm = document.querySelector('.admin-form');
      if (productForm && specificationList && specificationPayload) productForm.addEventListener('submit', function() {
        specificationPayload.value = JSON.stringify(Array.from(specificationList.querySelectorAll('[data-specification-card]')).map(getCardSpecification).filter(Boolean));
      });
      if (productForm && subcategorySection && subcategoryPayload) productForm.addEventListener('submit', function() {
        subcategoryPayload.value = JSON.stringify(Array.from(subcategorySection.querySelectorAll('[data-subcategory-option]:checked')).map(function(option) { return option.value; }));
      });
      var imageOrder = document.querySelector('[data-image-order]');
      var imageInput = document.querySelector('#product-images');
      var imageUrlInput = document.querySelector('#product-image');
      var carouselStage = document.querySelector('[data-carousel-stage]');
      var previewPosition = document.querySelector('[data-preview-position]');
      var previewIndex = 0;
      function updateCarouselPreview() {
          if (!imageOrder || !carouselStage) return;
          var orderedImages = Array.from(imageOrder.querySelectorAll('.admin-image-order-row img'));
          if (!orderedImages.length && imageUrlInput && imageUrlInput.value.trim()) orderedImages.push({ src: imageUrlInput.value.trim() });
          if (previewIndex >= orderedImages.length) previewIndex = 0;
          carouselStage.innerHTML = '';
          if (orderedImages.length) {
            var preview = document.createElement('img');
            preview.src = orderedImages[previewIndex].src;
            preview.alt = 'Prévia do carrossel';
            carouselStage.appendChild(preview);
            if (previewPosition) previewPosition.textContent = (previewIndex + 1) + ' / ' + orderedImages.length;
          } else {
            var empty = document.createElement('span');
            empty.textContent = 'Nenhuma imagem selecionada';
            carouselStage.appendChild(empty);
            if (previewPosition) previewPosition.textContent = '0 / 0';
          }
      }
      function addImageRow(token, src, label) {
          var row = document.createElement('div');
          row.className = 'admin-image-order-row';
          var hidden = document.createElement('input');
          hidden.type = 'hidden';
          hidden.name = 'carouselImageOrder';
          hidden.value = token;
          var image = document.createElement('img');
          image.src = src;
          image.alt = 'Foto do carrossel';
          var text = document.createElement('span');
          text.textContent = label;
          row.append(hidden, image, text);
          [['up', 'Mover foto para cima', 'bi-arrow-up'], ['down', 'Mover foto para baixo', 'bi-arrow-down'], ['remove', 'Remover foto', 'bi-trash3-fill']].forEach(function(action) {
            var button = document.createElement('button');
            button.type = 'button';
            button.className = 'admin-icon-button' + (action[0] === 'remove' ? ' admin-icon-button-danger' : '');
            button.setAttribute(action[0] === 'remove' ? 'data-remove-image' : 'data-move-image', action[0]);
            button.setAttribute('aria-label', action[1]);
            button.title = action[1];
            button.innerHTML = '<i class="bi ' + action[2] + '" aria-hidden="true"></i>';
            row.appendChild(button);
          });
          imageOrder.appendChild(row);
      }
      if (imageOrder) imageOrder.addEventListener('click', function(event) {
          var button = event.target.closest('[data-move-image]');
          var row = event.target.closest('.admin-image-order-row');
          if (button && row) {
            if (button.dataset.moveImage === 'up' && row.previousElementSibling) row.parentNode.insertBefore(row, row.previousElementSibling);
            if (button.dataset.moveImage === 'down' && row.nextElementSibling) row.parentNode.insertBefore(row.nextElementSibling, row);
            previewIndex = 0;
          }
          if (event.target.closest('[data-remove-image]') && row) {
            row.remove();
            if (!imageOrder.querySelector('.admin-image-order-row') && imageUrlInput) imageUrlInput.value = '';
          }
          updateCarouselPreview();
      });
      document.querySelector('[data-preview-prev]').addEventListener('click', function() {
          var total = imageOrder.querySelectorAll('.admin-image-order-row').length || (imageUrlInput && imageUrlInput.value.trim() ? 1 : 0);
          if (total) previewIndex = (previewIndex - 1 + total) % total;
          updateCarouselPreview();
      });
      document.querySelector('[data-preview-next]').addEventListener('click', function() {
          var total = imageOrder.querySelectorAll('.admin-image-order-row').length || (imageUrlInput && imageUrlInput.value.trim() ? 1 : 0);
          if (total) previewIndex = (previewIndex + 1) % total;
          updateCarouselPreview();
      });
      if (imageInput && imageOrder) imageInput.addEventListener('change', function() {
          imageOrder.querySelectorAll('[data-upload-preview]').forEach(function(row) { row.remove(); });
          Array.from(imageInput.files || []).forEach(function(file, index) {
            addImageRow('upload:' + index, URL.createObjectURL(file), file.name);
            imageOrder.lastElementChild.setAttribute('data-upload-preview', '');
          });
          updateCarouselPreview();
      });
      if (imageUrlInput) imageUrlInput.addEventListener('input', updateCarouselPreview);
      updateCarouselPreview();
    })();
