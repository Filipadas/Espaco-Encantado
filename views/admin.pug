extends layout

block content
  main.admin-page
    .admin-title-row
      a.admin-small-button(href='/' aria-label='Voltar para a tela inicial' title='Voltar para a tela inicial')
        i.bi.bi-arrow-left(aria-hidden='true')
      div
        p.admin-eyebrow ÁREA RESTRITA
        h1.admin-title Painel administrativo
    p.admin-subtitle Olá, #{currentUser.name}. Escolha uma função exclusiva para administrar a loja.
    .admin-dashboard-grid
      a.admin-dashboard-card(href='/admin/usuarios')
        i.bi.bi-people-fill
        h2 Gerenciamento de usuários
        p Consulte contas e altere permissões de acesso.
      a.admin-dashboard-card(href='/admin/produtos')
        i.bi.bi-box-seam-fill
        h2 Gerenciamento de produtos
        p Consulte, organize e remova produtos do catálogo.
      a.admin-dashboard-card(href='/admin/produtos/novo')
        i.bi.bi-plus-circle-fill
        h2 Cadastrar produto
        p Adicione brinquedos, decorações e kits à loja.
      a.admin-dashboard-card(href='/admin/estoque')
        i.bi.bi-boxes
        h2 Controle de estoque
        p Ajuste quantidades e acompanhe itens disponíveis.
      a.admin-dashboard-card(href='/admin/agenda')
        i.bi.bi-calendar-range-fill
        h2 Agenda
        p Visualize solicitações, reuniões e a agenda completa em um só lugar.
      a.admin-dashboard-card(href='/admin/configuracoes')
        i.bi.bi-sliders
        h2 Configurações
        p Edite textos de login e horários disponíveis.
      a.admin-dashboard-card(href='/admin/carrossel')
        i.bi.bi-images
        h2 Fotos da tela inicial
        p Troque as imagens do carrossel.
      a.admin-dashboard-card(href='/admin/comprovantes')
        i.bi.bi-receipt
        h2 Comprovantes de locação
        p Consulte o status das notas das solicitações.
